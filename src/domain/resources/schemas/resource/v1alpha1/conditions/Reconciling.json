{
  "$schema": "https://opendatafabric.org/schemas/resources/v1alpha1/meta/ResourceCondition",
  "$id": "https://kamu.dev/schemas/resource/v1alpha1/conditions/Reconciling",
  "title": "Reconciling Resource Condition",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "Value": {
      "type": "string",
      "enum": [
        "True",
        "False",
        "Unknown"
      ]
    }
  },
  "required": [
    "value",
    "reason",
    "lastTransitionTime"
  ],
  "properties": {
    "value": {
      "$ref": "#/$defs/Value"
    },
    "reason": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "lastTransitionTime": {
      "type": "string",
      "format": "date-time"
    }
  }
}
