////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Transform
// Engine-specific processing queries that shape the resulting data.
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/Transform
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

union Transform {
  TransformSql,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SqlQueryStep
// Defines a query in a multi-step SQL transformation.
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/SqlQueryStep
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SqlQueryStep {
  // Name of the temporary view that will be created from result of the query. Step without this alias will be treated as an output of the transformation.
  alias: string;
  // SQL query the result of which will be exposed under the alias.
  query: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TemporalTable
// Temporary Flink-specific extension for creating temporal tables from streams.
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/TemporalTable
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TemporalTable {
  // Name of the dataset to be converted into a temporal table.
  name: string;
  // Column names used as the primary key for creating a table.
  primary_key: [string];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TransformSql
// Transform using one of the SQL dialects.
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/Transform#/$defs/Sql
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TransformSql {
  // Identifier of the engine used for this transformation.
  engine: string;
  // Version of the engine to use.
  version: string;
  // SQL query the result of which will be used as an output. This is a convenience property meant only for defining queries by hand. When stored in the metadata this property will never be set and instead will be converted into a single-iter `queries` array.
  query: string;
  // Specifies multi-step SQL transformations. Each step acts as a shorthand for `CREATE TEMPORARY VIEW <alias> AS (<query>)`. Last query in the array should have no alias and will be treated as an output.
  queries: [SqlQueryStep];
  // Temporary Flink-specific extension for creating temporal tables from streams.
  temporal_tables: [TemporalTable];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// MergeStrategy
// Merge strategy determines how newly ingested data should be combined with the data that already exists in the dataset.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/MergeStrategy
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

union MergeStrategy {
  MergeStrategyAppend,
  MergeStrategyLedger,
  MergeStrategySnapshot,
  MergeStrategyChangelogStream,
  MergeStrategyUpsertStream,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// MergeStrategyAppend
// Append merge strategy.
// 
// Under this strategy new data will be appended to the dataset in its entirety, without any deduplication.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/MergeStrategy#/$defs/Append
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table MergeStrategyAppend {
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// MergeStrategyLedger
// Ledger merge strategy.
// 
// This strategy should be used for data sources containing ledgers of events. Currently this strategy will only perform deduplication of events using user-specified primary key columns. This means that the source data can contain partially overlapping set of records and only those records that were not previously seen will be appended.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/MergeStrategy#/$defs/Ledger
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table MergeStrategyLedger {
  // Names of the columns that uniquely identify the record throughout its lifetime
  primary_key: [string];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// MergeStrategySnapshot
// Snapshot merge strategy.
// 
// This strategy can be used for data state snapshots that are taken periodically and contain only the latest state of the observed entity or system. Over time such snapshots can have new rows added, and old rows either removed or modified.
// 
// This strategy transforms snapshot data into an append-only event stream where data already added is immutable. It does so by performing Change Data Capture - essentially diffing the current state of data against the reconstructed previous state and recording differences as retractions or corrections. The Operation Type "op" column will contain:
//   - append (`+A`) when a row appears for the first time
//   - retraction (`-R`) when row disappears
//   - correction (`-C`, `+C`) when row data has changed, with `-C` event carrying the old value of the row and `+C` carrying the new value.
// 
// To correctly associate rows between old and new snapshots this strategy relies on user-specified primary key columns.
// 
// To identify whether a row has changed this strategy will compare all other columns one by one. If the data contains a column that is guaranteed to change whenever any of the data columns changes (for example a last modification timestamp, an incremental version, or a data hash), then it can be specified in `compareColumns` property to speed up the detection of modified rows.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/MergeStrategy#/$defs/Snapshot
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table MergeStrategySnapshot {
  // Names of the columns that uniquely identify the record throughout its lifetime.
  primary_key: [string];
  // Names of the columns to compared to determine if a row has changed between two snapshots.
  compare_columns: [string];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// MergeStrategyChangelogStream
// Changelog stream merge strategy.
// 
// This is the native stream format for ODF that accurately describes the evolution of all event records including appends, retractions, and corrections as per RFC-015. No pre-processing except for format validation is done.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/MergeStrategy#/$defs/ChangelogStream
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table MergeStrategyChangelogStream {
  // Names of the columns that uniquely identify the record throughout its lifetime
  primary_key: [string];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// MergeStrategyUpsertStream
// Upsert stream merge strategy.
// 
// This strategy should be used for data sources containing ledgers of insert-or-update and delete events. Unlike ChangelogStream the insert-or-update events only carry the new values, so this strategy will use primary key to re-classify the events into an append or a correction from/to pair, looking up the previous values.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/MergeStrategy#/$defs/UpsertStream
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table MergeStrategyUpsertStream {
  // Names of the columns that uniquely identify the record throughout its lifetime
  primary_key: [string];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// AddPushSource
// Describes how to ingest data into a root dataset from a certain logical source.
//
// Schema: https://opendatafabric.org/schemas/legacy/v0/AddPushSource
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table AddPushSource {
  // Identifies the source within this dataset.
  source_name: string;
  // Defines how data is read into structured format.
  read: ReadStep;
  // Pre-processing query that shapes the data.
  preprocess: Transform;
  // Determines how newly-ingested data should be merged with existing history.
  merge: MergeStrategy;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// AttachmentEmbedded
// Embedded attachment item.
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/AttachmentEmbedded
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table AttachmentEmbedded {
  // Path to an attachment if it was materialized into a file.
  path: string;
  // Content of the attachment.
  content: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Attachments
// Defines the source of attachment files.
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/Attachments
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

union Attachments {
  AttachmentsEmbedded,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// AttachmentsEmbedded
// For attachments that are specified inline and are embedded in the metadata.
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/Attachments#/$defs/Embedded
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table AttachmentsEmbedded {
  // List of embedded items.
  items: [AttachmentEmbedded];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ResourceOwnerHandle
// Link to a resolved account that can own resources: `User`, `Organization`, or `Node`.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/ResourceOwnerHandle
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table ResourceOwnerHandle {
  // ID of the account resource.
  id: [ubyte];
  // DID of the account.
  did: [ubyte];
  // Name of the account.
  name: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ValueHandle
// Reference to a value within a `VariableSet` or a `SecretSet`.
//
// Schema: https://opendatafabric.org/schemas/config/v1alpha1/ValueHandle
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table ValueHandle {
  // Account that owns the target resource.
  account: ResourceOwnerHandle;
  // Type URI of the target resource.
  type: string;
  // ID of the resource within a node.
  id: [ubyte];
  // Name of a resource.
  name: string;
  // JSON path to a value within a `VariableSet` or a `SecretSet`.
  //
  // Examples:
  // - "port"
  // - "postgres.schemaName"
  path: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// AwsCredentials
// Access credentials for AWS or an AWS-compatible service.
//
// Schema: https://opendatafabric.org/schemas/storage/v1alpha1/AwsCredentials
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table AwsCredentials {
  // Reference to a secret containing the AWS access key ID.
  access_key: ValueHandle;
  // Reference to a secret containing the AWS secret access key.
  secret_key: ValueHandle;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ResourceOwnerRef
// Reference to an account that can own resources: `User`, `Organization`, or `Node`. Short form is the account name, as names of these accounts are unique within a node.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/ResourceOwnerRef
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table ResourceOwnerRef {
  // UUID of the account resource.
  id: [ubyte];
  // DID of the account.
  did: [ubyte];
  // Name of the account.
  name: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ValueRef
// Reference to a value within a `VariableSet` or a `SecretSet`.
//
// Schema: https://opendatafabric.org/schemas/config/v1alpha1/ValueRef
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table ValueRef {
  // Reference to an account that owns the `VariableSet` or the `SecretSet`.
  account: ResourceOwnerRef;
  // ID of a resource.
  id: [ubyte];
  // Short type name or full type URI of the target resource.
  //
  // Examples:
  // - "SecretSet"
  // - "VariableSet"
  // - "https://opendatafabric.org/schemas/config/v1alpha1/SecretSet"
  type: string;
  // Name of a resource.
  name: string;
  // JSON path to a value within a `VariableSet` or a `SecretSet`.
  //
  // Examples:
  // - "port"
  // - "postgres.schemaName"
  path: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// AwsCredentialsInput
// Access credentials for AWS or an AWS-compatible service.
//
// Schema: https://opendatafabric.org/schemas/storage/v1alpha1/AwsCredentialsInput
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table AwsCredentialsInput {
  // Reference to a secret containing the AWS access key ID.
  access_key: ValueRef;
  // Reference to a secret containing the AWS secret access key.
  secret_key: ValueRef;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SubjectHandle
// Resolved reference to a party a grant is given to.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/SubjectHandle
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

union SubjectHandle {
  SubjectHandleResource,
  SubjectHandleAuthenticated,
  SubjectHandleAnonymous,
  SubjectHandleEveryone,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SubjectHandleResource
// A specific `User`, `ServiceAccount`, `Node`, or members of a `Group`.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/SubjectHandle#/$defs/Resource
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SubjectHandleResource {
  // Type URI of the subject resource.
  type: string;
  // Account that owns the subject resource (for service accounts and groups).
  account: ResourceOwnerHandle;
  // ID of the subject resource.
  id: [ubyte];
  // DID of the subject resource, if applicable.
  did: [ubyte];
  // Name of the subject resource.
  name: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SubjectHandleAuthenticated
// Matches any authenticated principal.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/SubjectHandle#/$defs/Authenticated
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SubjectHandleAuthenticated {
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SubjectHandleAnonymous
// Matches any unauthenticated principal.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/SubjectHandle#/$defs/Anonymous
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SubjectHandleAnonymous {
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SubjectHandleEveryone
// Matches any principal, authenticated or not.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/SubjectHandle#/$defs/Everyone
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SubjectHandleEveryone {
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// CompressionFormat
// Defines a compression algorithm.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/CompressionFormat
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

enum CompressionFormat: int32 {
  Gzip,
  Zip,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ResourceLabels
// Map of string keys and values that can be used to organize, categorize, and query resources.
//
// Schema: https://opendatafabric.org/schemas/resources/v1alpha1/ResourceLabels
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table ResourceLabelsEntry {
  key: string (key);
  // JSON encoded
  value: string (json);
}
table ResourceLabels {
  // Key-value map
  entries: [ResourceLabelsEntry];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ResourceAnnotations
// Annotations is an unstructured key value map stored with a resource that may be set by external tools to store and retrieve arbitrary metadata. Unlike labels, annotations are not indexed and cannot be queried by.
//
// Schema: https://opendatafabric.org/schemas/resources/v1alpha1/ResourceAnnotations
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table ResourceAnnotationsEntry {
  key: string (key);
  // JSON encoded
  value: string (json);
}
table ResourceAnnotations {
  // Key-value map
  entries: [ResourceAnnotationsEntry];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ResourceRef
// Reference to another resource.
//
// Schema: https://opendatafabric.org/schemas/resources/v1alpha1/ResourceRef
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table ResourceRef {
  // Reference to an account that owns the target resource.
  account: ResourceOwnerRef;
  // ID of the resource within a node.
  id: [ubyte];
  // DID of the resource.
  did: [ubyte];
  // Short type name or full type URI of the target resource.
  //
  // Examples:
  // - "SecretSet"
  // - "https://opendatafabric.org/schemas/config/v1alpha1/SecretSet"
  type: string;
  // Name of a resource.
  name: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ResourceHeadersInput
// Container for identity and ownership information of a resource.
//
// Schema: https://opendatafabric.org/schemas/resources/v1alpha1/ResourceHeadersInput
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table ResourceHeadersInput {
  // Unique identifier of a resource within entire ODF node. Automatically assigned upon resource creation.
  id: [ubyte];
  // Symbolic name of a resource that identifies it within a scope of an onwing account.
  name: string;
  // Reference to the account that owns the resource.
  account: ResourceOwnerRef;
  // Map of string keys and values that can be used to organize, categorize, and query resources.
  labels: ResourceLabels;
  // Annotations is a key value map stored with a resource that may be set by external tools to store and retrieve arbitrary metadata. Unlike labels, annotations are not indexed and cannot be queried by.
  annotations: ResourceAnnotations;
  // References to resources that created this resource. Used for lineage tracking and cascading cleanup.
  owner_references: [ResourceRef];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// DatasetKind
// Represents type of the dataset.
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/DatasetKind
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

enum DatasetKind: int32 {
  Root,
  Derivative,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// MetadataEvent
// Represents a transaction that occurred on a dataset.
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/MetadataEvent
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

union MetadataEvent {
  AddData,
  ExecuteTransform,
  Seed,
  SetPollingSource,
  SetTransform,
  SetVocab,
  SetAttachments,
  SetInfo,
  SetLicense,
  SetDataSchema,
  AddPushSource,
  DisablePushSource,
  DisablePollingSource,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ExecuteTransformInput
// Describes a slice of the input dataset used during a transformation
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/ExecuteTransformInput
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table ExecuteTransformInput {
  // Input dataset identifier.
  dataset_id: [ubyte];
  // Last block of the input dataset that was previously incorporated into the derivative transformation, if any. Must be equal to the last non-empty `newBlockHash`. Together with `newBlockHash` defines a half-open `(prevBlockHash, newBlockHash]` interval of blocks that will be considered in this transaction.
  prev_block_hash: [ubyte];
  // Hash of the last block that will be incorporated into the derivative transformation. When present, defines a half-open `(prevBlockHash, newBlockHash]` interval of blocks that will be considered in this transaction.
  new_block_hash: [ubyte];
  // Last data record offset in the input dataset that was previously incorporated into the derivative transformation, if any. Must be equal to the last non-empty `newOffset`. Together with `newOffset` defines a half-open `(prevOffset, newOffset]` interval of data records that will be considered in this transaction.
  prev_offset: uint64 = null;
  // Offset of the last data record that will be incorporated into the derivative transformation, if any. When present, defines a half-open `(prevOffset, newOffset]` interval of data records that will be considered in this transaction.
  new_offset: uint64 = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ExecuteTransform
// Indicates that derivative transformation has been performed.
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/ExecuteTransform
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table ExecuteTransform {
  // Defines inputs used in this transaction. Slices corresponding to every input dataset must be present.
  query_inputs: [ExecuteTransformInput];
  // Hash of the checkpoint file used to restore transformation state, if any.
  prev_checkpoint: [ubyte];
  // Last offset of the previous data slice, if any. Must be equal to the last non-empty `newData.offsetInterval.end`.
  prev_offset: uint64 = null;
  // Describes output data written during this transaction, if any.
  new_data: DataSlice;
  // Describes checkpoint written during this transaction, if any. If an engine operation resulted in no updates to the checkpoint, but checkpoint is still relevant for subsequent runs - a hash of the previous checkpoint should be specified.
  new_checkpoint: Checkpoint;
  // Last watermark of the output data stream, if any. Initial blocks may not have watermarks, but once watermark is set - all subsequent blocks should either carry the same watermark or specify a new (greater) one. Thus, watermarks are monotonically non-decreasing.
  new_watermark: Timestamp;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Seed
// Establishes the identity of the dataset. Always the first metadata event in the chain.
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/Seed
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table Seed {
  // Unique identity of the dataset.
  dataset_id: [ubyte];
  // Type of the dataset.
  dataset_kind: DatasetKind;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FetchStep
// Defines the external source of data.
//
// Schema: https://opendatafabric.org/schemas/legacy/v0/FetchStep
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

union FetchStep {
  FetchStepUrl,
  FetchStepFilesGlob,
  FetchStepContainer,
  FetchStepMqtt,
  FetchStepEthereumLogs,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// EventTimeSource
// Defines the external source of data.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/EventTimeSource
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

union EventTimeSource {
  EventTimeSourceFromMetadata,
  EventTimeSourceFromPath,
  EventTimeSourceFromSystemTime,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// EventTimeSourceFromMetadata
// Extracts event time from the source's metadata.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/EventTimeSource#/$defs/FromMetadata
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table EventTimeSourceFromMetadata {
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// EventTimeSourceFromPath
// Extracts event time from the path component of the source.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/EventTimeSource#/$defs/FromPath
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table EventTimeSourceFromPath {
  // Regular expression where first group contains the timestamp string.
  pattern: string;
  // Format of the expected timestamp in java.text.SimpleDateFormat form.
  timestamp_format: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// EventTimeSourceFromSystemTime
// Assigns event time from the system time source.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/EventTimeSource#/$defs/FromSystemTime
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table EventTimeSourceFromSystemTime {
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SourceCaching
// Defines how external data should be cached.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/SourceCaching
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

union SourceCaching {
  SourceCachingForever,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SourceCachingForever
// After source was processed once it will never be ingested again.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/SourceCaching#/$defs/Forever
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SourceCachingForever {
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// RequestHeader
// Defines a header (e.g. HTTP) to be passed into some request.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/RequestHeader
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table RequestHeader {
  // Name of the header.
  name: string;
  // Value of the header.
  value: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FetchStepUrl
// Pulls data from one of the supported sources by its URL.
//
// Schema: https://opendatafabric.org/schemas/legacy/v0/FetchStep#/$defs/Url
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FetchStepUrl {
  // URL of the data source
  url: string;
  // Describes how event time is extracted from the source metadata.
  event_time: EventTimeSource;
  // Describes the caching settings used for this source.
  cache: SourceCaching;
  // Headers to pass during the request (e.g. HTTP Authorization)
  headers: [RequestHeader];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SourceOrdering
// Specifies how input files should be ordered before ingestion.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/SourceOrdering
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

enum SourceOrdering: int32 {
  ByEventTime,
  ByName,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FetchStepFilesGlob
// Uses glob operator to match files on the local file system.
//
// Schema: https://opendatafabric.org/schemas/legacy/v0/FetchStep#/$defs/FilesGlob
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FetchStepFilesGlob {
  // Path with a glob pattern.
  path: string;
  // Describes how event time is extracted from the source metadata.
  event_time: EventTimeSource;
  // Describes the caching settings used for this source.
  cache: SourceCaching;
  // Specifies how input files should be ordered before ingestion.
  // Order is important as every file will be processed individually
  // and will advance the dataset's watermark.
  order: SourceOrdering = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// EnvVar
// Defines an environment variable passed into some job.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/EnvVar
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table EnvVar {
  // Name of the variable.
  name: string;
  // Value of the variable.
  value: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FetchStepContainer
// Runs the specified OCI container to fetch data from an arbitrary source.
//
// Schema: https://opendatafabric.org/schemas/legacy/v0/FetchStep#/$defs/Container
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FetchStepContainer {
  // Image name and and an optional tag.
  image: string;
  // Specifies the entrypoint. Not executed within a shell. The default OCI image's ENTRYPOINT is used if this is not provided.
  command: [string];
  // Arguments to the entrypoint. The OCI image's CMD is used if this is not provided.
  args: [string];
  // Environment variables to propagate into or set in the container.
  env: [EnvVar];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// MqttQos
// MQTT quality of service class.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/MqttQos
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

enum MqttQos: int32 {
  AtMostOnce,
  AtLeastOnce,
  ExactlyOnce,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// MqttTopicSubscription
// MQTT topic subscription parameters.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/MqttTopicSubscription
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table MqttTopicSubscription {
  // Name of the topic (may include patterns).
  path: string;
  // Quality of service class.
  //
  // Defaults to: "AtMostOnce"
  qos: MqttQos = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FetchStepMqtt
// Connects to an MQTT broker to fetch events from the specified topic.
//
// Schema: https://opendatafabric.org/schemas/legacy/v0/FetchStep#/$defs/Mqtt
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FetchStepMqtt {
  // Hostname of the MQTT broker.
  host: string;
  // Port of the MQTT broker.
  port: int32;
  // Username to use for auth with the broker.
  username: string;
  // Password to use for auth with the broker (can be templated).
  password: string;
  // List of topic subscription parameters.
  topics: [MqttTopicSubscription];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FetchStepEthereumLogs
// Connects to an Ethereum node to stream transaction logs.
//
// Schema: https://opendatafabric.org/schemas/legacy/v0/FetchStep#/$defs/EthereumLogs
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FetchStepEthereumLogs {
  // Identifier of the chain to scan logs from. This parameter may be used for RPC endpoint lookup as well as asserting that provided `nodeUrl` corresponds to the expected chain.
  chain_id: uint64 = null;
  // Url of the node.
  node_url: string;
  // An SQL WHERE clause that can be used to pre-filter the logs before fetching them from the ETH node.
  //
  // Examples:
  // - "block_number > 123 and address = X'5fbdb2315678afecb367f032d93f642f64180aa3' and topic1 = X'000000000000000000000000f39fd6e51aad88f6f4ce6ab8827279cfffb92266'"
  filter: string;
  // Solidity log event signature to use for decoding. Using this field adds `event` to the output containing decoded log as JSON.
  signature: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// PrepStep
// Defines the steps to prepare raw data for ingestion.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/PrepStep
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

union PrepStep {
  PrepStepDecompress,
  PrepStepPipe,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// PrepStepDecompress
// Pulls data from one of the supported sources by its URL.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/PrepStep#/$defs/Decompress
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table PrepStepDecompress {
  // Name of a compression algorithm used on data.
  format: CompressionFormat;
  // Path to a data file within a multi-file archive. Can contain glob patterns.
  sub_path: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// PrepStepPipe
// Executes external command to process the data using piped input/output.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/PrepStep#/$defs/Pipe
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table PrepStepPipe {
  // Command to execute and its arguments.
  command: [string];
}

table PrepStepWrapper {
  value: PrepStep;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SetPollingSource
// Contains information on how externally-hosted data can be ingested into the root dataset.
//
// Schema: https://opendatafabric.org/schemas/legacy/v0/SetPollingSource
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SetPollingSource {
  // Determines where data is sourced from.
  fetch: FetchStep;
  // Defines how raw data is prepared before reading.
  prepare: [PrepStepWrapper];
  // Defines how data is read into structured format.
  read: ReadStep;
  // Pre-processing query that shapes the data.
  preprocess: Transform;
  // Determines how newly-ingested data should be merged with existing history.
  merge: MergeStrategy;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TransformInput
// Describes a derivative transformation input
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/TransformInput
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TransformInput {
  // A local or remote dataset reference. When block is accepted this MUST be in the form of a DatasetId to guarantee reproducibility, as aliases can change over time.
  dataset_ref: string;
  // An alias under which this input will be available in queries. Will be populated from `datasetRef` if not provided before resolving it to DatasetId.
  alias: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SetTransform
// Defines a transformation that produces data in a derivative dataset.
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/SetTransform
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SetTransform {
  // Datasets that will be used as sources.
  inputs: [TransformInput];
  // Transformation that will be applied to produce new data.
  transform: Transform;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SetVocab
// Lets you manipulate names of the system columns to avoid conflicts.
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/SetVocab
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SetVocab {
  // Name of the offset column.
  offset_column: string;
  // Name of the operation type column.
  operation_type_column: string;
  // Name of the system time column.
  system_time_column: string;
  // Name of the event time column.
  event_time_column: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SetAttachments
// Associates a set of files with this dataset.
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/SetAttachments
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SetAttachments {
  // One of the supported attachment sources.
  attachments: Attachments;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SetInfo
// Provides basic human-readable information about a dataset.
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/SetInfo
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SetInfo {
  // Brief single-sentence summary of a dataset.
  description: string;
  // Keywords, search terms, or tags used to describe the dataset.
  keywords: [string];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SetLicense
// Defines a license that applies to this dataset.
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/SetLicense
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SetLicense {
  // Abbreviated name of the license.
  short_name: string;
  // Full name of the license.
  name: string;
  // License identifier from the SPDX License List.
  spdx_id: string;
  // URL where licensing terms can be found.
  website_url: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SetDataSchema
// Specifies the complete schema of Data Slices added to the Dataset following this event.
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/SetDataSchema
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SetDataSchema {
  // DEPRECATED: Apache Arrow schema encoded in its native flatbuffers representation.
  raw_arrow_schema: [ubyte] (id: 0);
  // Defines the logical schema of the data files that follow this event. Will become a required field after migration.
  schema: DataSchema (id: 1);
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// DisablePushSource
// Disables the previously defined source.
//
// Schema: https://opendatafabric.org/schemas/legacy/v0/DisablePushSource
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table DisablePushSource {
  // Identifies the source to be disabled.
  source_name: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// DisablePollingSource
// Disables the previously defined polling source.
//
// Schema: https://opendatafabric.org/schemas/legacy/v0/DisablePollingSource
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table DisablePollingSource {
}

table MetadataEventWrapper {
  value: MetadataEvent;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// PersistentVolumeRef
// Reference to a `PersistentVolume`.
//
// Schema: https://opendatafabric.org/schemas/storage/v1alpha1/PersistentVolumeRef
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table PersistentVolumeRef {
  // Reference to an account that owns the `PersistentVolume`.
  account: ResourceOwnerRef;
  // ID of the resource.
  id: [ubyte];
  // Name of the resource.
  name: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// DatasetSpecInput
// Represents a desired state of the dataset metadata.
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/DatasetSpecInput
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table DatasetSpecInput {
  // DID of the dataset in global ODF network
  did: [ubyte];
  // Type of the dataset.
  kind: DatasetKind;
  // An array of metadata events that will be used to populate the chain, e.g. to set info, licenses, and attachments. As the dataset evolves, it maintains a snapshot of the key events that describe the dataset in its latest state, excluding intermediate transitions (e.g. previous schema changes) and events related to ingestions and transformations.
  metadata: [MetadataEventWrapper];
  // Reference to a storage volume where dataset data will be stored. If omitted, the node's default storage is used.
  volume: PersistentVolumeRef;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// DatasetHandle
// Link to a dataset.
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/DatasetHandle
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table DatasetHandle {
  // Reference to an account that owns the dataset.
  account: ResourceOwnerHandle;
  // ID of the dataset resource.
  id: [ubyte];
  // DID of the dataset.
  did: [ubyte];
  // Name of the dataset.
  name: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// DatasetRef
// Reference to a dataset.
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/DatasetRef
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table DatasetRef {
  // Reference to an account that owns the dataset.
  account: ResourceOwnerRef;
  // UUID of the dataset resource.
  id: [ubyte];
  // DID of the dataset.
  did: [ubyte];
  // Name of the dataset.
  name: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// LabelFilter
// Filters that work on resource labels and identity headers.
//
// Schema: https://opendatafabric.org/schemas/resources/v1alpha1/LabelFilter
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table LabelFilterEntry {
  key: string (key);
  // JSON encoded
  value: string (json);
}
table LabelFilter {
  // Key-value map
  entries: [LabelFilterEntry];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// DatasetSelector
// Selects one or more datasets by name pattern and optional filters.
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/DatasetSelector
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table DatasetSelector {
  // Reference to an account that owns the target resources.
  account: ResourceOwnerRef;
  // ID of the singular resource.
  id: [ubyte];
  // Name pattern in SQL `LIKE` format.
  //
  // Examples:
  // - "%"
  // - "my-dataset-%"
  // - "org.opendata.%"
  name: string;
  // Filter by resource labels.
  labels: LabelFilter;
  // Restricts the selector to datasets of a specific kind.
  kind: DatasetKind = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// DatasetSnapshot
// Represents a projection of the dataset metadata at a single point in time.
// This type is typically used for defining new datasets and changing the existing ones.
//
// Schema: https://opendatafabric.org/schemas/legacy/v0/DatasetSnapshot
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table DatasetSnapshot {
  // Alias of the dataset.
  name: string;
  // Type of the dataset.
  kind: DatasetKind;
  // An array of metadata events that will be used to populate the chain. Here you can define polling and push sources, set licenses, add attachments etc.
  metadata: [MetadataEventWrapper];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ResourceHandle
// Link to another resolved resource.
//
// Schema: https://opendatafabric.org/schemas/resources/v1alpha1/ResourceHandle
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table ResourceHandle {
  // Account that owns the target resource.
  account: ResourceOwnerHandle;
  // Type URI of the target resource.
  type: string;
  // ID of the resource within a node.
  id: [ubyte];
  // DID of the resource, if applicable.
  did: [ubyte];
  // Name of a resource.
  name: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// DatasetSpec
// Represents a desired state of the dataset metadata.
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/DatasetSpec
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table DatasetSpec {
  // DID of the dataset in global ODF network
  did: [ubyte];
  // Type of the dataset.
  kind: DatasetKind;
  // An array of metadata events that will be used to populate the chain, e.g. to set info, licenses, and attachments. As the dataset evolves, it maintains a snapshot of the key events that describe the dataset in its latest state, excluding intermediate transitions (e.g. previous schema changes) and events related to ingestions and transformations.
  metadata: [MetadataEventWrapper];
  // Reference to a storage volume where dataset data will be stored. If omitted, the node's default storage is used.
  volume: ResourceHandle;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// DatasetVocabulary
// Specifies the mapping of system columns onto dataset schema.
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/DatasetVocabulary
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table DatasetVocabulary {
  // Name of the offset column.
  //
  // Defaults to: "offset"
  offset_column: string;
  // Name of the operation type column.
  //
  // Defaults to: "op"
  operation_type_column: string;
  // Name of the system time column.
  //
  // Defaults to: "system_time"
  system_time_column: string;
  // Name of the event time column.
  //
  // Defaults to: "event_time"
  event_time_column: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// EventFilter
// Filters that work on domain event types and fields.
//
// Schema: https://opendatafabric.org/schemas/events/v1alpha1/EventFilter
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table EventFilterEntry {
  key: string (key);
  // JSON encoded
  value: string (json);
}
table EventFilter {
  // Key-value map
  entries: [EventFilterEntry];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FailureBehavior
// Determines how a flow run proceeds when a task finishes with a `Failed` outcome.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/FailureBehavior
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

enum FailureBehavior: int32 {
  Fail,
  Continue,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ResourceSelector
// Matches zero or many resources using identity and label filters.
//
// Schema: https://opendatafabric.org/schemas/resources/v1alpha1/ResourceSelector
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table ResourceSelector {
  // Reference to an account that owns the target resources.
  account: ResourceOwnerRef;
  // ID of the singular resource.
  id: [ubyte];
  // DID of the resource.
  did: [ubyte];
  // Short type name of the target resource e.g. `SecretSet` or a full schema URI e.g. `https://opendatafabric.org/schemas/config/v1alpha1/SecretSet`.
  type: string;
  // Name pattern in SQL `LIKE` format.
  //
  // Examples:
  // - "%"
  // - "my-resource-%"
  // - "%-prod"
  name: string;
  // Filter by resource labels.
  labels: LabelFilter;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// PrincipalRef
// Reference to an identity that can act as a principal: `User`, `ServiceAccount`, or `Node`. Short form requires a type prefix, e.g. `ServiceAccount:acme/ingest-prod`.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/PrincipalRef
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table PrincipalRef {
  // Short type name or full type URI of the principal.
  type: string;
  // Reference to an account that owns the service account.
  account: ResourceOwnerRef;
  // ID of the principal resource.
  id: [ubyte];
  // DID of the principal.
  did: [ubyte];
  // Name of the principal resource.
  name: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowTriggerInput
// Condition that causes a flow to be executed.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowTriggerInput
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

union FlowTriggerInput {
  FlowTriggerInputManual,
  FlowTriggerInputSchedule,
  FlowTriggerInputInterval,
  FlowTriggerInputEvent,
  FlowTriggerInputSource,
  FlowTriggerInputInputsUpdated,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowTriggerInputManual
// Triggers the flow via an API call or UI action.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowTriggerInput#/$defs/Manual
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FlowTriggerInputManual {
  // Allows to pause an individual trigger.
  //
  // Defaults to: true
  enabled: bool = null;
  // Minimum interval between activations of the trigger. If the trigger fires again within the interval, the activation is postponed until the interval ends, batching multiple activations into one flow run.
  cooldown: Duration;
  // If the trigger is activated this many times during the `cooldown` interval, it fires without waiting for the interval to end.
  cooldown_max_batch: uint64 = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowTriggerInputSchedule
// Triggers the flow on a cron schedule.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowTriggerInput#/$defs/Schedule
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FlowTriggerInputSchedule {
  // Allows to pause an individual trigger.
  //
  // Defaults to: true
  enabled: bool = null;
  // Minimum interval between activations of the trigger. If the trigger fires again within the interval, the activation is postponed until the interval ends, batching multiple activations into one flow run.
  cooldown: Duration;
  // If the trigger is activated this many times during the `cooldown` interval, it fires without waiting for the interval to end.
  cooldown_max_batch: uint64 = null;
  // Cron5 expression defining the schedule e.g. `@daily` or `*/30 * * * *`.
  cron: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowTriggerInputInterval
// Triggers the flow at regular intervals.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowTriggerInput#/$defs/Interval
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FlowTriggerInputInterval {
  // Allows to pause an individual trigger.
  //
  // Defaults to: true
  enabled: bool = null;
  // Minimum interval between activations of the trigger. If the trigger fires again within the interval, the activation is postponed until the interval ends, batching multiple activations into one flow run.
  cooldown: Duration;
  // If the trigger is activated this many times during the `cooldown` interval, it fires without waiting for the interval to end.
  cooldown_max_batch: uint64 = null;
  // Interval between activations e.g. `15m`.
  interval: Duration;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowTriggerInputEvent
// Triggers the flow when an event bus event matching one of the filters is observed.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowTriggerInput#/$defs/Event
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FlowTriggerInputEvent {
  // Allows to pause an individual trigger.
  //
  // Defaults to: true
  enabled: bool = null;
  // Filters the event by type and fields.
  events: EventFilter;
  // Minimum interval between activations of the trigger. If the trigger fires again within the interval, the activation is postponed until the interval ends, batching multiple activations into one flow run.
  cooldown: Duration;
  // If the trigger is activated this many times during the `cooldown` interval, it fires without waiting for the interval to end.
  cooldown_max_batch: uint64 = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowTriggerInputSource
// Triggers the flow when a source receives new data, with optional batching controls.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowTriggerInput#/$defs/Source
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FlowTriggerInputSource {
  // Allows to pause an individual trigger.
  //
  // Defaults to: true
  enabled: bool = null;
  // Minimum interval between activations of the trigger. If the trigger fires again within the interval, the activation is postponed until the interval ends, batching multiple activations into one flow run.
  cooldown: Duration;
  // If the trigger is activated this many times during the `cooldown` interval, it fires without waiting for the interval to end.
  cooldown_max_batch: uint64 = null;
  // Reference to the source resource that drives this trigger.
  source: ResourceRef;
  // Minimum number of new records to accumulate before triggering.
  min_records_to_await: uint64 = null;
  // Maximum time to wait for `minRecordsToAwait` before triggering anyway e.g. `1h`.
  max_await_interval: Duration;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowTriggerInputInputsUpdated
// Triggers the flow when inputs of a derivative dataset receive new data, with optional batching controls.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowTriggerInput#/$defs/InputsUpdated
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FlowTriggerInputInputsUpdated {
  // Allows to pause an individual trigger.
  //
  // Defaults to: true
  enabled: bool = null;
  // Minimum interval between activations of the trigger. If the trigger fires again within the interval, the activation is postponed until the interval ends, batching multiple activations into one flow run.
  cooldown: Duration;
  // If the trigger is activated this many times during the `cooldown` interval, it fires without waiting for the interval to end.
  cooldown_max_batch: uint64 = null;
  // Selector of derivative datasets whose inputs are watched. Defaults to the flow-level target when omitted.
  target: DatasetSelector;
  // Minimum number of new input records to accumulate before triggering.
  min_records_to_await: uint64 = null;
  // Maximum time to wait for `minRecordsToAwait` before triggering anyway e.g. `1h`.
  max_await_interval: Duration;
}

table FlowTriggerInputWrapper {
  value: FlowTriggerInput;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskSpecInput
// An individual work item to be executed as part of a flow.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskSpecInput
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

union TaskSpecInput {
  TaskSpecInputIngest,
  TaskSpecInputTransform,
  TaskSpecInputSyncFrom,
  TaskSpecInputSyncTo,
  TaskSpecInputCompaction,
  TaskSpecInputReset,
  TaskSpecInputGarbageCollection,
  TaskSpecInputVerify,
  TaskSpecInputWebhookCall,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// NoOpBehavior
// Determines how a flow run proceeds when a task finishes with a `NoOp` outcome.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/NoOpBehavior
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

enum NoOpBehavior: int32 {
  Continue,
  Break,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskSpecInputIngest
// Fetches data from a source and appends it to a dataset.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskSpecInput#/$defs/Ingest
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TaskSpecInputIngest {
  // An alias for the task used to refer to it in flows and access the results
  name: string;
  // Reference to the dataset to ingest into. Defaults to the flow-level target when omitted.
  target: DatasetRef;
  // Service account whose permissions the task executes with. Must be an account of service account type. Defaults to the service account of the run when omitted.
  service_account: PrincipalRef;
  // How the flow run proceeds when this task finishes with a `NoOp` outcome: `Continue` executes the next task, while `Break` finishes the flow run early without an error.
  //
  // Defaults to: "Continue"
  on_no_op: NoOpBehavior = null;
  // How the flow run proceeds when this task finishes with a `Failed` outcome: `Fail` finishes the flow run with an error, while `Continue` executes the next task.
  //
  // Defaults to: "Fail"
  on_failure: FailureBehavior = null;
  // Reference to the source resource that defines how to fetch data.
  source: ResourceRef;
  // Target number of records to ingest per data slice.
  target_records_per_slice: uint64 = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskSpecInputTransform
// Executes transformation of data defined in a derivative dataset.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskSpecInput#/$defs/Transform
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TaskSpecInputTransform {
  // An alias for the task used to refer to it in flows and access the results
  name: string;
  // Reference to the derivative dataset that defines how to transform data.
  target: DatasetRef;
  // Service account whose permissions the task executes with. Must be an account of service account type. Defaults to the service account of the run when omitted.
  service_account: PrincipalRef;
  // How the flow run proceeds when this task finishes with a `NoOp` outcome: `Continue` executes the next task, while `Break` finishes the flow run early without an error.
  //
  // Defaults to: "Continue"
  on_no_op: NoOpBehavior = null;
  // How the flow run proceeds when this task finishes with a `Failed` outcome: `Fail` finishes the flow run with an error, while `Continue` executes the next task.
  //
  // Defaults to: "Fail"
  on_failure: FailureBehavior = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SyncAuthInput
// Credentials used to access a remote location during a sync.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/SyncAuthInput
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

union SyncAuthInput {
  SyncAuthInputBearer,
  SyncAuthInputAws,
  SyncAuthInputHeaders,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SyncAuthInputBearer
// Authenticates with a bearer token, e.g. an access token of a remote ODF node.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/SyncAuthInput#/$defs/Bearer
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SyncAuthInputBearer {
  // Reference to a secret containing the token.
  token: ValueRef;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SyncAuthInputAws
// Authenticates with AWS or an AWS-compatible object storage.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/SyncAuthInput#/$defs/Aws
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SyncAuthInputAws {
  // S3 endpoint URL. If omitted, defaults to AWS S3. Use for S3-compatible stores.
  endpoint: string;
  // AWS region where the bucket is located e.g. `us-west-2`.
  region: string;
  // Reference to a secret containing the AWS access key ID.
  access_key: ValueRef;
  // Reference to a secret containing the AWS secret access key.
  secret_key: ValueRef;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SyncAuthHeaderInput
// A request header whose value is taken from a `VariableSet` or a `SecretSet`.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/SyncAuthHeaderInput
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SyncAuthHeaderInput {
  // Name of the header.
  name: string;
  // Reference to the value of the header.
  value: ValueRef;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SyncAuthInputHeaders
// Authenticates by passing custom request headers.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/SyncAuthInput#/$defs/Headers
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SyncAuthInputHeaders {
  // Headers to pass with every request.
  headers: [SyncAuthHeaderInput];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SyncEndpointInput
// A remote location a dataset is synced with.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/SyncEndpointInput
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SyncEndpointInput {
  // URL of the remote dataset. The scheme selects the transfer protocol e.g. `odf+https://`, `s3://`, `file://`.
  url: string;
  // Credentials used to access the remote location.
  auth: SyncAuthInput;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskSpecInputSyncFrom
// Pulls new blocks from a remote dataset into a local dataset.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskSpecInput#/$defs/SyncFrom
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TaskSpecInputSyncFrom {
  // An alias for the task used to refer to it in flows and access the results
  name: string;
  // Reference to the local dataset to pull into. Defaults to the flow-level target when omitted.
  target: DatasetRef;
  // Service account whose permissions the task executes with. Must be an account of service account type. Defaults to the service account of the run when omitted.
  service_account: PrincipalRef;
  // How the flow run proceeds when this task finishes with a `NoOp` outcome: `Continue` executes the next task, while `Break` finishes the flow run early without an error.
  //
  // Defaults to: "Continue"
  on_no_op: NoOpBehavior = null;
  // How the flow run proceeds when this task finishes with a `Failed` outcome: `Fail` finishes the flow run with an error, while `Continue` executes the next task.
  //
  // Defaults to: "Fail"
  on_failure: FailureBehavior = null;
  // Remote dataset to pull from.
  source: SyncEndpointInput;
  // Overwrite the local dataset even if its history has diverged from the source.
  //
  // Defaults to: false
  force: bool = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskSpecInputSyncTo
// Pushes new blocks of a local dataset to a remote dataset.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskSpecInput#/$defs/SyncTo
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TaskSpecInputSyncTo {
  // An alias for the task used to refer to it in flows and access the results
  name: string;
  // Reference to the local dataset to push. Defaults to the flow-level target when omitted.
  target: DatasetRef;
  // Service account whose permissions the task executes with. Must be an account of service account type. Defaults to the service account of the run when omitted.
  service_account: PrincipalRef;
  // How the flow run proceeds when this task finishes with a `NoOp` outcome: `Continue` executes the next task, while `Break` finishes the flow run early without an error.
  //
  // Defaults to: "Continue"
  on_no_op: NoOpBehavior = null;
  // How the flow run proceeds when this task finishes with a `Failed` outcome: `Fail` finishes the flow run with an error, while `Continue` executes the next task.
  //
  // Defaults to: "Fail"
  on_failure: FailureBehavior = null;
  // Remote dataset to push to.
  destination: SyncEndpointInput;
  // Overwrite the remote dataset even if its history has diverged from the local one.
  //
  // Defaults to: false
  force: bool = null;
  // Create the remote dataset if it does not exist.
  //
  // Defaults to: true
  create_if_not_exists: bool = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskSpecInputCompaction
// Compacts data files in matching datasets to improve query performance.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskSpecInput#/$defs/Compaction
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TaskSpecInputCompaction {
  // An alias for the task used to refer to it in flows and access the results
  name: string;
  // Reference to the dataset to compact. Defaults to the flow-level target when omitted.
  target: DatasetRef;
  // Service account whose permissions the task executes with. Must be an account of service account type. Defaults to the service account of the run when omitted.
  service_account: PrincipalRef;
  // How the flow run proceeds when this task finishes with a `NoOp` outcome: `Continue` executes the next task, while `Break` finishes the flow run early without an error.
  //
  // Defaults to: "Continue"
  on_no_op: NoOpBehavior = null;
  // How the flow run proceeds when this task finishes with a `Failed` outcome: `Fail` finishes the flow run with an error, while `Continue` executes the next task.
  //
  // Defaults to: "Fail"
  on_failure: FailureBehavior = null;
  // Target maximum size of each compacted data slice e.g. `100MiB`.
  max_slice_size: uint64 = null;
  // Target maximum number of records per compacted data slice.
  max_slice_records: uint64 = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskSpecInputReset
// Moves a block reference of a dataset to an earlier block, discarding the history that follows it.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskSpecInput#/$defs/Reset
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TaskSpecInputReset {
  // An alias for the task used to refer to it in flows and access the results
  name: string;
  // Reference to the dataset to reset. Defaults to the flow-level target when omitted.
  target: DatasetRef;
  // Service account whose permissions the task executes with. Must be an account of service account type. Defaults to the service account of the run when omitted.
  service_account: PrincipalRef;
  // How the flow run proceeds when this task finishes with a `NoOp` outcome: `Continue` executes the next task, while `Break` finishes the flow run early without an error.
  //
  // Defaults to: "Continue"
  on_no_op: NoOpBehavior = null;
  // How the flow run proceeds when this task finishes with a `Failed` outcome: `Fail` finishes the flow run with an error, while `Continue` executes the next task.
  //
  // Defaults to: "Fail"
  on_failure: FailureBehavior = null;
  // Name of the block reference to reset.
  //
  // Defaults to: "head"
  ref: string;
  // Hash of the block the reference will point to. Defaults to the `Seed` block when omitted.
  new_block_hash: [ubyte];
  // Expected hash of the block the reference currently points to. When specified, the task fails if the reference has moved, protecting against concurrent updates.
  old_block_hash: [ubyte];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskSpecInputGarbageCollection
// Removes unreferenced data files from matching datasets.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskSpecInput#/$defs/GarbageCollection
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TaskSpecInputGarbageCollection {
  // An alias for the task used to refer to it in flows and access the results
  name: string;
  // Reference to the dataset to collect garbage from. Defaults to the flow-level target when omitted.
  target: DatasetRef;
  // Service account whose permissions the task executes with. Must be an account of service account type. Defaults to the service account of the run when omitted.
  service_account: PrincipalRef;
  // How the flow run proceeds when this task finishes with a `NoOp` outcome: `Continue` executes the next task, while `Break` finishes the flow run early without an error.
  //
  // Defaults to: "Continue"
  on_no_op: NoOpBehavior = null;
  // How the flow run proceeds when this task finishes with a `Failed` outcome: `Fail` finishes the flow run with an error, while `Continue` executes the next task.
  //
  // Defaults to: "Fail"
  on_failure: FailureBehavior = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskSpecInputVerify
// Checks dataset metadata for integrity.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskSpecInput#/$defs/Verify
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TaskSpecInputVerify {
  // An alias for the task used to refer to it in flows and access the results
  name: string;
  // Reference to the dataset to verify. Defaults to the flow-level target when omitted.
  target: DatasetRef;
  // Service account whose permissions the task executes with. Must be an account of service account type. Defaults to the service account of the run when omitted.
  service_account: PrincipalRef;
  // How the flow run proceeds when this task finishes with a `NoOp` outcome: `Continue` executes the next task, while `Break` finishes the flow run early without an error.
  //
  // Defaults to: "Continue"
  on_no_op: NoOpBehavior = null;
  // How the flow run proceeds when this task finishes with a `Failed` outcome: `Fail` finishes the flow run with an error, while `Continue` executes the next task.
  //
  // Defaults to: "Fail"
  on_failure: FailureBehavior = null;
  // If true, re-executes transformations on derivative datasets to verify reproducibility.
  replay_transform: bool = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// RetryBackoff
// Type of the backoff scaling.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/RetryBackoff
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

enum RetryBackoff: int32 {
  Linear,
  Exponential,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// RetryPolicy
// Defines how a flow should react to failures.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/RetryPolicy
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table RetryPolicy {
  // Number of attempts before flow auto-scheduling will be disabled.
  max_attempts: uint32 = null;
  // How long to wait until the first retry.
  min_delay: Duration;
  // Type of the backoff scaling. When omitted, retries use a constant `minDelay`.
  backoff: RetryBackoff = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskSpecInputWebhookCall
// Dispatches a certain payload to a specific `WebhookEndpoint`.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskSpecInput#/$defs/WebhookCall
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TaskSpecInputWebhookCall {
  // An alias for the task used to refer to it in flows and access the results
  name: string;
  // Service account whose permissions the task executes with. Must be an account of service account type. Defaults to the service account of the run when omitted.
  service_account: PrincipalRef;
  // How the flow run proceeds when this task finishes with a `NoOp` outcome: `Continue` executes the next task, while `Break` finishes the flow run early without an error.
  //
  // Defaults to: "Continue"
  on_no_op: NoOpBehavior = null;
  // How the flow run proceeds when this task finishes with a `Failed` outcome: `Fail` finishes the flow run with an error, while `Continue` executes the next task.
  //
  // Defaults to: "Fail"
  on_failure: FailureBehavior = null;
  // Reference to the `WebhookEndpoint`.
  endpoint: ResourceRef;
  // The payload to send. May include templating.
  payload: string;
  // Defines how a webhook should react to failures.
  retry_policy: RetryPolicy;
}

table TaskSpecInputWrapper {
  value: TaskSpecInput;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// RecentBindingsRetention
// Controls how many recent bindings are reported in `FlowStatus.recentBindings`.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/RecentBindingsRetention
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table RecentBindingsRetention {
  // Maximum number of recent bindings to report.
  max_bindings: uint32 = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// RecentRunsRetention
// Controls how many recent runs are reported in `FlowStatus.recentRuns`. Implementations may additionally cap these values.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/RecentRunsRetention
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table RecentRunsRetention {
  // Maximum number of recent runs to report.
  max_runs: uint32 = null;
  // Maximum age of a finished run to be reported e.g. `30d`.
  max_age: Duration;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowSpecInput
// Defines a sequence of tasks to be executed upon certain trigger conditions.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowSpecInput
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FlowSpecInput {
  // Defines resources for which this flow will be instantiated.
  target: ResourceSelector;
  // Service account whose permissions the tasks of this flow execute with. Must be an account of service account type. Required for flows owned by an organization. When omitted, tasks execute with the permissions of the user account that owns the flow.
  service_account: PrincipalRef;
  // Conditions that cause this flow to execute.
  triggers: [FlowTriggerInputWrapper];
  // List of tasks to run consecutively.
  tasks: [TaskSpecInputWrapper];
  // Defines how a flow should react to failures.
  retry_policy: RetryPolicy;
  // Controls retention of `FlowStatus.recentBindings`.
  recent_bindings_retention: RecentBindingsRetention;
  // Controls retention of `FlowStatus.recentRuns`.
  recent_runs_retention: RecentRunsRetention;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowRunSpecInput
// Defines a set of tasks to be executed in a sequence.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowRunSpecInput
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FlowRunSpecInput {
  // Defines the default target resources on which tasks will be performed.
  target: ResourceRef;
  // Service account whose permissions the tasks of this run execute with. Must be an account of service account type. A run created by the flow controller copies it from the `Flow`.
  service_account: PrincipalRef;
  // List of tasks to run consecutively.
  tasks: [TaskSpecInputWrapper];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// PrincipalHandle
// Link to a resolved identity that can act as a principal: `User`, `ServiceAccount`, or `Node`.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/PrincipalHandle
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table PrincipalHandle {
  // Type URI of the principal.
  type: string;
  // Account that owns the service account.
  account: ResourceOwnerHandle;
  // ID of the principal resource.
  id: [ubyte];
  // DID of the principal, if applicable.
  did: [ubyte];
  // Name of the principal resource.
  name: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowTrigger
// Condition that causes a flow to be executed.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowTrigger
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

union FlowTrigger {
  FlowTriggerManual,
  FlowTriggerSchedule,
  FlowTriggerInterval,
  FlowTriggerEvent,
  FlowTriggerSource,
  FlowTriggerInputsUpdated,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowTriggerManual
// Triggers the flow via an API call or UI action.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowTrigger#/$defs/Manual
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FlowTriggerManual {
  // Allows to pause an individual trigger.
  //
  // Defaults to: true
  enabled: bool = null;
  // Minimum interval between activations of the trigger. If the trigger fires again within the interval, the activation is postponed until the interval ends, batching multiple activations into one flow run.
  cooldown: Duration;
  // If the trigger is activated this many times during the `cooldown` interval, it fires without waiting for the interval to end.
  cooldown_max_batch: uint64 = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowTriggerSchedule
// Triggers the flow on a cron schedule.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowTrigger#/$defs/Schedule
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FlowTriggerSchedule {
  // Allows to pause an individual trigger.
  //
  // Defaults to: true
  enabled: bool = null;
  // Minimum interval between activations of the trigger. If the trigger fires again within the interval, the activation is postponed until the interval ends, batching multiple activations into one flow run.
  cooldown: Duration;
  // If the trigger is activated this many times during the `cooldown` interval, it fires without waiting for the interval to end.
  cooldown_max_batch: uint64 = null;
  // Cron5 expression defining the schedule e.g. `@daily` or `*/30 * * * *`.
  cron: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowTriggerInterval
// Triggers the flow at regular intervals.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowTrigger#/$defs/Interval
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FlowTriggerInterval {
  // Allows to pause an individual trigger.
  //
  // Defaults to: true
  enabled: bool = null;
  // Minimum interval between activations of the trigger. If the trigger fires again within the interval, the activation is postponed until the interval ends, batching multiple activations into one flow run.
  cooldown: Duration;
  // If the trigger is activated this many times during the `cooldown` interval, it fires without waiting for the interval to end.
  cooldown_max_batch: uint64 = null;
  // Interval between activations e.g. `15m`.
  interval: Duration;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowTriggerEvent
// Triggers the flow when an event bus event matching one of the filters is observed.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowTrigger#/$defs/Event
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FlowTriggerEvent {
  // Allows to pause an individual trigger.
  //
  // Defaults to: true
  enabled: bool = null;
  // Filters the event by type and fields.
  events: EventFilter;
  // Minimum interval between activations of the trigger. If the trigger fires again within the interval, the activation is postponed until the interval ends, batching multiple activations into one flow run.
  cooldown: Duration;
  // If the trigger is activated this many times during the `cooldown` interval, it fires without waiting for the interval to end.
  cooldown_max_batch: uint64 = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowTriggerSource
// Triggers the flow when a source receives new data, with optional batching controls.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowTrigger#/$defs/Source
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FlowTriggerSource {
  // Allows to pause an individual trigger.
  //
  // Defaults to: true
  enabled: bool = null;
  // Minimum interval between activations of the trigger. If the trigger fires again within the interval, the activation is postponed until the interval ends, batching multiple activations into one flow run.
  cooldown: Duration;
  // If the trigger is activated this many times during the `cooldown` interval, it fires without waiting for the interval to end.
  cooldown_max_batch: uint64 = null;
  // Reference to the source resource that drives this trigger.
  source: ResourceHandle;
  // Minimum number of new records to accumulate before triggering.
  min_records_to_await: uint64 = null;
  // Maximum time to wait for `minRecordsToAwait` before triggering anyway e.g. `1h`.
  max_await_interval: Duration;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowTriggerInputsUpdated
// Triggers the flow when inputs of a derivative dataset receive new data, with optional batching controls.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowTrigger#/$defs/InputsUpdated
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FlowTriggerInputsUpdated {
  // Allows to pause an individual trigger.
  //
  // Defaults to: true
  enabled: bool = null;
  // Minimum interval between activations of the trigger. If the trigger fires again within the interval, the activation is postponed until the interval ends, batching multiple activations into one flow run.
  cooldown: Duration;
  // If the trigger is activated this many times during the `cooldown` interval, it fires without waiting for the interval to end.
  cooldown_max_batch: uint64 = null;
  // Selector of derivative datasets whose inputs are watched. Defaults to the flow-level target when omitted.
  target: DatasetSelector;
  // Minimum number of new input records to accumulate before triggering.
  min_records_to_await: uint64 = null;
  // Maximum time to wait for `minRecordsToAwait` before triggering anyway e.g. `1h`.
  max_await_interval: Duration;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowRunActivationCause
// Cause of the flow run activation
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowRunActivationCause
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FlowRunActivationCause {
  // Time at which the trigger fired.
  activation_time: Timestamp;
  // Principal that initiated the run, if applicable.
  initiator: PrincipalHandle;
  // Copy of the trigger configuration from the parent Flow that fired.
  trigger: FlowTrigger;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowRunActivationCauses
// Condition capturing what caused this FlowRun to be scheduled. Set by the controller at creation time; never written by users. In case of a retry, the causes of the original run are preserved.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowRunActivationCauses
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FlowRunActivationCauses {
  // Triggers that caused this run to be scheduled.
  activation_causes: [FlowRunActivationCause];
  // Additional triggers that fired while this run was already queued or executing.
  late_activation_causes: [FlowRunActivationCause];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowRunRetry
// Condition linking this FlowRun to the previous FlowRun it is retrying. Set by the controller; never written by users.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowRunRetry
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FlowRunRetry {
  // Reference to the FlowRun this run is retrying.
  retry_of: ResourceHandle;
  // Retry attempt number (1 = first retry, i.e. second run total).
  retry_number: uint32;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskSpec
// An individual work item to be executed as part of a flow.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskSpec
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

union TaskSpec {
  TaskSpecIngest,
  TaskSpecTransform,
  TaskSpecSyncFrom,
  TaskSpecSyncTo,
  TaskSpecCompaction,
  TaskSpecReset,
  TaskSpecGarbageCollection,
  TaskSpecVerify,
  TaskSpecWebhookCall,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskSpecIngest
// Fetches data from a source and appends it to a dataset.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskSpec#/$defs/Ingest
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TaskSpecIngest {
  // An alias for the task used to refer to it in flows and access the results
  name: string;
  // Reference to the dataset to ingest into. Defaults to the flow-level target when omitted.
  target: DatasetHandle;
  // Service account whose permissions the task executes with. Must be an account of service account type. Defaults to the service account of the run when omitted.
  service_account: PrincipalHandle;
  // How the flow run proceeds when this task finishes with a `NoOp` outcome: `Continue` executes the next task, while `Break` finishes the flow run early without an error.
  //
  // Defaults to: "Continue"
  on_no_op: NoOpBehavior = null;
  // How the flow run proceeds when this task finishes with a `Failed` outcome: `Fail` finishes the flow run with an error, while `Continue` executes the next task.
  //
  // Defaults to: "Fail"
  on_failure: FailureBehavior = null;
  // Reference to the source resource that defines how to fetch data.
  source: ResourceHandle;
  // Target number of records to ingest per data slice.
  target_records_per_slice: uint64 = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskSpecTransform
// Executes transformation of data defined in a derivative dataset.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskSpec#/$defs/Transform
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TaskSpecTransform {
  // An alias for the task used to refer to it in flows and access the results
  name: string;
  // Reference to the derivative dataset that defines how to transform data.
  target: DatasetHandle;
  // Service account whose permissions the task executes with. Must be an account of service account type. Defaults to the service account of the run when omitted.
  service_account: PrincipalHandle;
  // How the flow run proceeds when this task finishes with a `NoOp` outcome: `Continue` executes the next task, while `Break` finishes the flow run early without an error.
  //
  // Defaults to: "Continue"
  on_no_op: NoOpBehavior = null;
  // How the flow run proceeds when this task finishes with a `Failed` outcome: `Fail` finishes the flow run with an error, while `Continue` executes the next task.
  //
  // Defaults to: "Fail"
  on_failure: FailureBehavior = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SyncAuth
// Credentials used to access a remote location during a sync.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/SyncAuth
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

union SyncAuth {
  SyncAuthBearer,
  SyncAuthAws,
  SyncAuthHeaders,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SyncAuthBearer
// Authenticates with a bearer token, e.g. an access token of a remote ODF node.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/SyncAuth#/$defs/Bearer
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SyncAuthBearer {
  // Reference to a secret containing the token.
  token: ValueHandle;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SyncAuthAws
// Authenticates with AWS or an AWS-compatible object storage.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/SyncAuth#/$defs/Aws
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SyncAuthAws {
  // S3 endpoint URL. If omitted, defaults to AWS S3. Use for S3-compatible stores.
  endpoint: string;
  // AWS region where the bucket is located e.g. `us-west-2`.
  region: string;
  // Reference to a secret containing the AWS access key ID.
  access_key: ValueHandle;
  // Reference to a secret containing the AWS secret access key.
  secret_key: ValueHandle;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SyncAuthHeader
// A request header whose value is taken from a `VariableSet` or a `SecretSet`.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/SyncAuthHeader
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SyncAuthHeader {
  // Name of the header.
  name: string;
  // Reference to the value of the header.
  value: ValueHandle;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SyncAuthHeaders
// Authenticates by passing custom request headers.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/SyncAuth#/$defs/Headers
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SyncAuthHeaders {
  // Headers to pass with every request.
  headers: [SyncAuthHeader];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SyncEndpoint
// A remote location a dataset is synced with.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/SyncEndpoint
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SyncEndpoint {
  // URL of the remote dataset. The scheme selects the transfer protocol e.g. `odf+https://`, `s3://`, `file://`.
  url: string;
  // Credentials used to access the remote location.
  auth: SyncAuth;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskSpecSyncFrom
// Pulls new blocks from a remote dataset into a local dataset.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskSpec#/$defs/SyncFrom
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TaskSpecSyncFrom {
  // An alias for the task used to refer to it in flows and access the results
  name: string;
  // Reference to the local dataset to pull into. Defaults to the flow-level target when omitted.
  target: DatasetHandle;
  // Service account whose permissions the task executes with. Must be an account of service account type. Defaults to the service account of the run when omitted.
  service_account: PrincipalHandle;
  // How the flow run proceeds when this task finishes with a `NoOp` outcome: `Continue` executes the next task, while `Break` finishes the flow run early without an error.
  //
  // Defaults to: "Continue"
  on_no_op: NoOpBehavior = null;
  // How the flow run proceeds when this task finishes with a `Failed` outcome: `Fail` finishes the flow run with an error, while `Continue` executes the next task.
  //
  // Defaults to: "Fail"
  on_failure: FailureBehavior = null;
  // Remote dataset to pull from.
  source: SyncEndpoint;
  // Overwrite the local dataset even if its history has diverged from the source.
  //
  // Defaults to: false
  force: bool = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskSpecSyncTo
// Pushes new blocks of a local dataset to a remote dataset.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskSpec#/$defs/SyncTo
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TaskSpecSyncTo {
  // An alias for the task used to refer to it in flows and access the results
  name: string;
  // Reference to the local dataset to push. Defaults to the flow-level target when omitted.
  target: DatasetHandle;
  // Service account whose permissions the task executes with. Must be an account of service account type. Defaults to the service account of the run when omitted.
  service_account: PrincipalHandle;
  // How the flow run proceeds when this task finishes with a `NoOp` outcome: `Continue` executes the next task, while `Break` finishes the flow run early without an error.
  //
  // Defaults to: "Continue"
  on_no_op: NoOpBehavior = null;
  // How the flow run proceeds when this task finishes with a `Failed` outcome: `Fail` finishes the flow run with an error, while `Continue` executes the next task.
  //
  // Defaults to: "Fail"
  on_failure: FailureBehavior = null;
  // Remote dataset to push to.
  destination: SyncEndpoint;
  // Overwrite the remote dataset even if its history has diverged from the local one.
  //
  // Defaults to: false
  force: bool = null;
  // Create the remote dataset if it does not exist.
  //
  // Defaults to: true
  create_if_not_exists: bool = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskSpecCompaction
// Compacts data files in matching datasets to improve query performance.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskSpec#/$defs/Compaction
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TaskSpecCompaction {
  // An alias for the task used to refer to it in flows and access the results
  name: string;
  // Reference to the dataset to compact. Defaults to the flow-level target when omitted.
  target: DatasetHandle;
  // Service account whose permissions the task executes with. Must be an account of service account type. Defaults to the service account of the run when omitted.
  service_account: PrincipalHandle;
  // How the flow run proceeds when this task finishes with a `NoOp` outcome: `Continue` executes the next task, while `Break` finishes the flow run early without an error.
  //
  // Defaults to: "Continue"
  on_no_op: NoOpBehavior = null;
  // How the flow run proceeds when this task finishes with a `Failed` outcome: `Fail` finishes the flow run with an error, while `Continue` executes the next task.
  //
  // Defaults to: "Fail"
  on_failure: FailureBehavior = null;
  // Target maximum size of each compacted data slice e.g. `100MiB`.
  max_slice_size: uint64 = null;
  // Target maximum number of records per compacted data slice.
  max_slice_records: uint64 = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskSpecReset
// Moves a block reference of a dataset to an earlier block, discarding the history that follows it.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskSpec#/$defs/Reset
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TaskSpecReset {
  // An alias for the task used to refer to it in flows and access the results
  name: string;
  // Reference to the dataset to reset. Defaults to the flow-level target when omitted.
  target: DatasetHandle;
  // Service account whose permissions the task executes with. Must be an account of service account type. Defaults to the service account of the run when omitted.
  service_account: PrincipalHandle;
  // How the flow run proceeds when this task finishes with a `NoOp` outcome: `Continue` executes the next task, while `Break` finishes the flow run early without an error.
  //
  // Defaults to: "Continue"
  on_no_op: NoOpBehavior = null;
  // How the flow run proceeds when this task finishes with a `Failed` outcome: `Fail` finishes the flow run with an error, while `Continue` executes the next task.
  //
  // Defaults to: "Fail"
  on_failure: FailureBehavior = null;
  // Name of the block reference to reset.
  //
  // Defaults to: "head"
  ref: string;
  // Hash of the block the reference will point to. Defaults to the `Seed` block when omitted.
  new_block_hash: [ubyte];
  // Expected hash of the block the reference currently points to. When specified, the task fails if the reference has moved, protecting against concurrent updates.
  old_block_hash: [ubyte];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskSpecGarbageCollection
// Removes unreferenced data files from matching datasets.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskSpec#/$defs/GarbageCollection
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TaskSpecGarbageCollection {
  // An alias for the task used to refer to it in flows and access the results
  name: string;
  // Reference to the dataset to collect garbage from. Defaults to the flow-level target when omitted.
  target: DatasetHandle;
  // Service account whose permissions the task executes with. Must be an account of service account type. Defaults to the service account of the run when omitted.
  service_account: PrincipalHandle;
  // How the flow run proceeds when this task finishes with a `NoOp` outcome: `Continue` executes the next task, while `Break` finishes the flow run early without an error.
  //
  // Defaults to: "Continue"
  on_no_op: NoOpBehavior = null;
  // How the flow run proceeds when this task finishes with a `Failed` outcome: `Fail` finishes the flow run with an error, while `Continue` executes the next task.
  //
  // Defaults to: "Fail"
  on_failure: FailureBehavior = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskSpecVerify
// Checks dataset metadata for integrity.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskSpec#/$defs/Verify
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TaskSpecVerify {
  // An alias for the task used to refer to it in flows and access the results
  name: string;
  // Reference to the dataset to verify. Defaults to the flow-level target when omitted.
  target: DatasetHandle;
  // Service account whose permissions the task executes with. Must be an account of service account type. Defaults to the service account of the run when omitted.
  service_account: PrincipalHandle;
  // How the flow run proceeds when this task finishes with a `NoOp` outcome: `Continue` executes the next task, while `Break` finishes the flow run early without an error.
  //
  // Defaults to: "Continue"
  on_no_op: NoOpBehavior = null;
  // How the flow run proceeds when this task finishes with a `Failed` outcome: `Fail` finishes the flow run with an error, while `Continue` executes the next task.
  //
  // Defaults to: "Fail"
  on_failure: FailureBehavior = null;
  // If true, re-executes transformations on derivative datasets to verify reproducibility.
  replay_transform: bool = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskSpecWebhookCall
// Dispatches a certain payload to a specific `WebhookEndpoint`.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskSpec#/$defs/WebhookCall
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TaskSpecWebhookCall {
  // An alias for the task used to refer to it in flows and access the results
  name: string;
  // Service account whose permissions the task executes with. Must be an account of service account type. Defaults to the service account of the run when omitted.
  service_account: PrincipalHandle;
  // How the flow run proceeds when this task finishes with a `NoOp` outcome: `Continue` executes the next task, while `Break` finishes the flow run early without an error.
  //
  // Defaults to: "Continue"
  on_no_op: NoOpBehavior = null;
  // How the flow run proceeds when this task finishes with a `Failed` outcome: `Fail` finishes the flow run with an error, while `Continue` executes the next task.
  //
  // Defaults to: "Fail"
  on_failure: FailureBehavior = null;
  // Reference to the `WebhookEndpoint`.
  endpoint: ResourceHandle;
  // The payload to send. May include templating.
  payload: string;
  // Defines how a webhook should react to failures.
  retry_policy: RetryPolicy;
}

table TaskSpecWrapper {
  value: TaskSpec;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowRunSpec
// Defines a set of tasks to be executed in a sequence.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowRunSpec
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FlowRunSpec {
  // Defines the default target resources on which tasks will be performed.
  target: ResourceHandle;
  // Service account whose permissions the tasks of this run execute with. Must be an account of service account type. A run created by the flow controller copies it from the `Flow`.
  service_account: PrincipalHandle;
  // List of tasks to run consecutively.
  tasks: [TaskSpecWrapper];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowRunStatusValue
// Overall execution status of the FlowRun.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowRunStatus#/$defs/Value
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

enum FlowRunStatusValue: int32 {
  Waiting,
  Running,
  Finished,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskStatus
// Execution phase of a task.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskStatus
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

enum TaskStatus: int32 {
  Pending,
  Queued,
  Running,
  Finished,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskOutcome
// Result of the execution of a task.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskOutcome
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

union TaskOutcome {
  TaskOutcomeSuccess,
  TaskOutcomeFailed,
  TaskOutcomeNoOp,
  TaskOutcomeCancelled,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskOutcomeSuccess
// Task completed successfully.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskOutcome#/$defs/Success
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TaskOutcomeSuccessEntry {
  key: string (key);
  // JSON encoded
  value: string (json);
}
table TaskOutcomeSuccess {
  // Key-value map
  entries: [TaskOutcomeSuccessEntry];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskError
// Type-specific details of a task failure. The `kind` property identifies the error, e.g. `InputDatasetCompacted`, and the remaining properties depend on it.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskError
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TaskErrorEntry {
  key: string (key);
  // JSON encoded
  value: string (json);
}
table TaskError {
  // Key-value map
  entries: [TaskErrorEntry];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskOutcomeFailed
// Task failed.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskOutcome#/$defs/Failed
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TaskOutcomeFailed {
  // Human-readable description of the failure.
  message: string;
  // Whether retrying the task could succeed, e.g. after a network error. An unrecoverable failure, such as an invalid query, would fail the same way again.
  recoverable: bool;
  // Type-specific details of the failure.
  error: TaskError;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskOutcomeNoOp
// Task completed with no work done (e.g. no new data to process).
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskOutcome#/$defs/NoOp
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TaskOutcomeNoOp {
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskOutcomeCancelled
// Task was cancelled before completion.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskOutcome#/$defs/Cancelled
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TaskOutcomeCancelled {
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowRunStatusTaskEntry
// Describes a task spawned by this FlowRun.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowRunStatus#/$defs/TaskEntry
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FlowRunStatusTaskEntry {
  // Corresponds to the task name in spec.tasks.
  name: string;
  // Reference to the spawned Task resource.
  task: ResourceHandle;
  // Current execution phase of this task.
  status: TaskStatus;
  // Outcome kind once the task has finished.
  outcome: TaskOutcome;
  // Last time at which this task's status has been updated.
  last_updated_at: Timestamp;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowRunStatus
// Condition tracking the overall execution status of a FlowRun and its spawned tasks.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowRunStatus
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FlowRunStatus {
  // Overall execution status of the FlowRun.
  status: FlowRunStatusValue;
  // Tasks spawned by this FlowRun, in execution order.
  tasks: [FlowRunStatusTaskEntry];
}

table FlowTriggerWrapper {
  value: FlowTrigger;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowSpec
// Defines a sequence of tasks to be executed upon certain trigger conditions.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowSpec
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FlowSpec {
  // Defines resources for which this flow will be instantiated.
  target: ResourceSelector;
  // Service account whose permissions the tasks of this flow execute with. Must be an account of service account type. Required for flows owned by an organization. When omitted, tasks execute with the permissions of the user account that owns the flow.
  service_account: PrincipalHandle;
  // Conditions that cause this flow to execute.
  triggers: [FlowTriggerWrapper];
  // List of tasks to run consecutively.
  tasks: [TaskSpecWrapper];
  // Defines how a flow should react to failures.
  retry_policy: RetryPolicy;
  // Controls retention of `FlowStatus.recentBindings`.
  recent_bindings_retention: RecentBindingsRetention;
  // Controls retention of `FlowStatus.recentRuns`.
  recent_runs_retention: RecentRunsRetention;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowStatusValue
// Overall operational status of the Flow.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowStatus#/$defs/Value
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

enum FlowStatusValue: int32 {
  Active,
  Paused,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowStatusBindingEntry
// A resource currently matched by the flow's target selector.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowStatus#/$defs/BindingEntry
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FlowStatusBindingEntry {
  // The matched resource.
  target: ResourceHandle;
  // Time at which this binding was established.
  bound_at: Timestamp;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowStatusRunEntry
// Summary of a recent FlowRun.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowStatus#/$defs/RunEntry
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FlowStatusRunEntry {
  // Reference to the FlowRun resource.
  flow_run: ResourceHandle;
  // Execution status of this run.
  status: string;
  // Outcome of this run, if finished.
  outcome: string;
  // Time at which this run finished.
  finished_at: Timestamp;
  // Reference to the FlowRun this run is retrying, if applicable.
  retry_of: ResourceHandle;
  // Retry attempt number (1 = first retry, i.e. second run total).
  retry_number: uint32 = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// FlowStatus
// Condition tracking the overall status of a Flow and a summary of recent runs.
//
// Schema: https://opendatafabric.org/schemas/flows/v1alpha1/FlowStatus
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table FlowStatus {
  // Overall operational status of the Flow.
  status: FlowStatusValue;
  // Last N resources matched by the flow's target selector. Bounded by spec.recentBindingsRetention.
  recent_bindings: [FlowStatusBindingEntry];
  // Total number of resources currently matched by the flow's target selector.
  bindings_total: uint64 = null;
  // Summaries of recent FlowRuns. Bounded by spec.recentRunsRetention.
  recent_runs: [FlowStatusRunEntry];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SubjectRef
// Reference to a party a grant is given to. Unlike a principal, a subject may stand for many principals at once. Short form is either a well-known subject name (e.g. `Authenticated`) or a resource reference with a type prefix, DID, or ID (e.g. `Group:acme/engineering`).
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/SubjectRef
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

union SubjectRef {
  SubjectRefResource,
  SubjectRefAuthenticated,
  SubjectRefAnonymous,
  SubjectRefEveryone,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SubjectRefResource
// A specific `User`, `ServiceAccount`, `Node`, or members of a `Group`.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/SubjectRef#/$defs/Resource
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SubjectRefResource {
  // Short type name or full type URI of the subject resource.
  type: string;
  // Reference to an account that owns the subject resource (for service accounts and groups).
  account: ResourceOwnerRef;
  // ID of the subject resource.
  id: [ubyte];
  // DID of the subject resource.
  did: [ubyte];
  // Name of the subject resource.
  name: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SubjectRefAuthenticated
// Matches any authenticated principal.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/SubjectRef#/$defs/Authenticated
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SubjectRefAuthenticated {
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SubjectRefAnonymous
// Matches any unauthenticated principal.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/SubjectRef#/$defs/Anonymous
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SubjectRefAnonymous {
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SubjectRefEveryone
// Matches any principal, authenticated or not.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/SubjectRef#/$defs/Everyone
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SubjectRefEveryone {
}

table SubjectRefWrapper {
  value: SubjectRef;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// GroupSpecInput
// Group specification.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/GroupSpecInput
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table GroupSpecInput {
  // Members of the group. Only the `Resource` subject kind is allowed, so that well-known subjects like `Everyone` cannot be nested into a group.
  members: [SubjectRefWrapper];
}

table SubjectHandleWrapper {
  value: SubjectHandle;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// GroupSpec
// Group specification.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/GroupSpec
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table GroupSpec {
  // Members of the group. Only the `Resource` subject kind is allowed, so that well-known subjects like `Everyone` cannot be nested into a group.
  members: [SubjectHandleWrapper];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Ingress
// Defines the point where data enters the system.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/Ingress
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

union Ingress {
  IngressUrl,
  IngressFilesGlob,
  IngressContainer,
  IngressMqtt,
  IngressEvmLogs,
  IngressRestEndpoint,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// IngressUrl
// Pulls data from one of the supported sources by its URL.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/Ingress#/$defs/Url
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table IngressUrl {
  // URL of the data source
  url: string;
  // Describes how event time is extracted from the source metadata.
  event_time: EventTimeSource;
  // Describes the caching settings used for this source.
  cache: SourceCaching;
  // Headers to pass during the request (e.g. HTTP Authorization)
  headers: [RequestHeader];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// IngressFilesGlob
// Uses glob operator to match files on the local file system.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/Ingress#/$defs/FilesGlob
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table IngressFilesGlob {
  // Path with a glob pattern.
  path: string;
  // Describes how event time is extracted from the source metadata.
  event_time: EventTimeSource;
  // Describes the caching settings used for this source.
  cache: SourceCaching;
  // Specifies how input files should be ordered before ingestion.
  // Order is important as every file will be processed individually
  // and will advance the dataset's watermark.
  order: SourceOrdering = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// IngressContainer
// Runs the specified OCI container to fetch data from an arbitrary source.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/Ingress#/$defs/Container
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table IngressContainer {
  // Image name and and an optional tag.
  image: string;
  // Specifies the entrypoint. Not executed within a shell. The default OCI image's ENTRYPOINT is used if this is not provided.
  command: [string];
  // Arguments to the entrypoint. The OCI image's CMD is used if this is not provided.
  args: [string];
  // Environment variables to propagate into or set in the container.
  env: [EnvVar];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// IngressMqtt
// Connects to an MQTT broker to fetch events from the specified topic.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/Ingress#/$defs/Mqtt
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table IngressMqtt {
  // Hostname of the MQTT broker.
  host: string;
  // Port of the MQTT broker.
  port: int32;
  // Username to use for auth with the broker.
  username: string;
  // Password to use for auth with the broker (can be templated).
  password: string;
  // List of topic subscription parameters.
  topics: [MqttTopicSubscription];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// IngressEvmLogs
// Connects to an EVM (Ethereum) node to stream transaction logs.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/Ingress#/$defs/EvmLogs
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table IngressEvmLogs {
  // Identifier of the chain to scan logs from. This parameter may be used for RPC endpoint lookup as well as asserting that provided `nodeUrl` corresponds to the expected chain.
  chain_id: uint64 = null;
  // Url of the node.
  node_url: string;
  // An SQL WHERE clause that can be used to pre-filter the logs before fetching them from the ETH node.
  //
  // Examples:
  // - "block_number > 123 and address = X'5fbdb2315678afecb367f032d93f642f64180aa3' and topic1 = X'000000000000000000000000f39fd6e51aad88f6f4ce6ab8827279cfffb92266'"
  filter: string;
  // Solidity log event signature to use for decoding. Using this field adds `event` to the output containing decoded log as JSON.
  signature: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// IngressBuffer
// Buffer configuration for holding pushed records until they are ingested.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/IngressBuffer
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

union IngressBuffer {
  IngressBufferMemory,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// IngressBufferMemory
// An in-memory buffer.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/IngressBuffer#/$defs/Memory
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table IngressBufferMemory {
  // Maximum number of records to hold in the buffer.
  buffer_size: uint64 = null;
  // Policy applied when the buffer is full.
  overflow_policy: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// IngressRestEndpoint
// Exposes a REST HTTP endpoint that accepts pushed data records.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/Ingress#/$defs/RestEndpoint
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table IngressRestEndpoint {
  // Buffer configuration for holding records until they are ingested.
  buffer: IngressBuffer;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Manifest
// An object that wraps the metadata resources providing versioning and type identification. All root-level resources are wrapped with a manifest when serialized to disk.
//
// Schema: https://opendatafabric.org/schemas/legacy/v0/Manifest
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table Manifest {
  // Type of the resource.
  kind: int64;
  // Major version number of the resource contained in this manifest. It provides the mechanism for introducing compatibility breaking changes.
  version: int32;
  // Resource data.
  content: [ubyte];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// MetadataBlock
// An individual block in the metadata chain that captures the history of modifications of a dataset.
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/MetadataBlock
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table MetadataBlock {
  // System time when this block was written.
  system_time: Timestamp;
  // Hash sum of the preceding block.
  prev_block_hash: [ubyte];
  // Block sequence number, starting from zero at the seed block.
  sequence_number: uint64;
  // Event data.
  event: MetadataEvent;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// NodeSpecInput
// Node account specification.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/NodeSpecInput
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table NodeSpecInput {
  // DID associated with the account by ODF or an external system.
  did: [ubyte];
  // Human-friendly display name.
  display_name: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// NodeSpec
// Node account specification.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/NodeSpec
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table NodeSpec {
  // DID associated with the account by ODF or an external system.
  did: [ubyte];
  // Human-friendly display name.
  display_name: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// OperationType
// Defines an operation in a changelog stream.
//
// Schema: https://opendatafabric.org/schemas/data/v1alpha1/OperationType
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

enum OperationType: ubyte {
  Append,
  Retract,
  CorrectFrom,
  CorrectTo,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// OrganizationSpecInput
// Organization account specification.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/OrganizationSpecInput
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table OrganizationSpecInput {
  // Human-friendly display name.
  display_name: string;
  // URL of the account's avatar image.
  avatar_url: string;
  // Suspends the account. Effects of suspension are implementation-specific.
  //
  // Defaults to: false
  disabled: bool = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// OrganizationSpec
// Organization account specification.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/OrganizationSpec
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table OrganizationSpec {
  // Human-friendly display name.
  display_name: string;
  // URL of the account's avatar image.
  avatar_url: string;
  // Suspends the account. Effects of suspension are implementation-specific.
  //
  // Defaults to: false
  disabled: bool = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// PersistentVolumeSpecInput
// Defines a storage volume where data can be stored and its access credentials.
//
// Schema: https://opendatafabric.org/schemas/storage/v1alpha1/PersistentVolumeSpecInput
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

union PersistentVolumeSpecInput {
  PersistentVolumeSpecInputS3,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// VolumeCapacity
// Storage capacity allocation.
//
// Schema: https://opendatafabric.org/schemas/storage/v1alpha1/VolumeCapacity
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table VolumeCapacity {
  // Maximum storage size e.g. `10Gi`.
  storage: uint64 = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// PersistentVolumeSpecInputS3
// An Amazon S3 or S3-compatible object storage bucket.
//
// Schema: https://opendatafabric.org/schemas/storage/v1alpha1/PersistentVolumeSpecInput#/$defs/S3
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table PersistentVolumeSpecInputS3 {
  // S3 endpoint URL. If omitted, defaults to AWS S3. Use for S3-compatible stores e.g. `https://s3.amazonaws.com`.
  endpoint: string;
  // AWS region where the bucket is located e.g. `us-west-2`.
  region: string;
  // Name of the S3 bucket.
  bucket: string;
  // Optional path prefix within the bucket.
  prefix: string;
  // Storage capacity allocation.
  capacity: VolumeCapacity;
  // Access credentials for the bucket.
  credentials: AwsCredentialsInput;
}

union PersistentVolumeSpec {
  PersistentVolumeSpecS3,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// PersistentVolumeSpecS3
// An Amazon S3 or S3-compatible object storage bucket.
//
// Schema: https://opendatafabric.org/schemas/storage/v1alpha1/PersistentVolumeSpec#/$defs/S3
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table PersistentVolumeSpecS3 {
  // S3 endpoint URL. If omitted, defaults to AWS S3. Use for S3-compatible stores e.g. `https://s3.amazonaws.com`.
  endpoint: string;
  // AWS region where the bucket is located e.g. `us-west-2`.
  region: string;
  // Name of the S3 bucket.
  bucket: string;
  // Optional path prefix within the bucket.
  prefix: string;
  // Storage capacity allocation.
  capacity: VolumeCapacity;
  // Access credentials for the bucket.
  credentials: AwsCredentials;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// PersistentVolumeSpecRoot
//
// Schema: https://opendatafabric.org/schemas/storage/v1alpha1/PersistentVolumeSpecRoot
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table PersistentVolumeSpecRoot {
  value: PersistentVolumeSpec;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// PolicySpecInput
// Policy specification. The `kind` selects the policy language.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/PolicySpecInput
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

union PolicySpecInput {
  PolicySpecInputGeneric,
  PolicySpecInputCedar,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// PolicySpecInputGeneric
// Engine-agnostic policy that grants a set of actions. Subject and object are always supplied by a `PolicyBinding`.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/PolicySpecInput#/$defs/Generic
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table PolicySpecInputGeneric {
  // Schema URIs of actions granted by the policy.
  actions: [string];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// PolicySpecInputCedar
// Policy expressed in the Cedar policy language. Policies that declare `?principal` and `?resource` slots are templates instantiated via `PolicyBinding`, otherwise they take effect on their own. Only supported by nodes that use Cedar.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/PolicySpecInput#/$defs/Cedar
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table PolicySpecInputCedar {
  // Cedar policy source.
  body: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// PolicyRef
// Reference to a `Policy`.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/PolicyRef
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table PolicyRef {
  // Reference to an account that owns the `Policy`.
  account: ResourceOwnerRef;
  // ID of the resource.
  id: [ubyte];
  // Name of the resource.
  name: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// PolicyBindingSpecInput
// Policy binding specification.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/PolicyBindingSpecInput
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table PolicyBindingSpecInput {
  // Policy template to instantiate.
  policy: PolicyRef;
  // Party the permissions are granted to.
  subject: SubjectRef;
  // Resource the permissions are granted on. Refers to both the resource and the entity materialized from it.
  object: ResourceRef;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// PolicyBindingSpec
// Policy binding specification.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/PolicyBindingSpec
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table PolicyBindingSpec {
  // Policy template to instantiate.
  policy: ResourceHandle;
  // Party the permissions are granted to.
  subject: SubjectHandle;
  // Resource the permissions are granted on. Refers to both the resource and the entity materialized from it.
  object: ResourceHandle;
}

union PolicySpec {
  PolicySpecGeneric,
  PolicySpecCedar,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// PolicySpecGeneric
// Engine-agnostic policy that grants a set of actions. Subject and object are always supplied by a `PolicyBinding`.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/PolicySpec#/$defs/Generic
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table PolicySpecGeneric {
  // Schema URIs of actions granted by the policy.
  actions: [string];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// PolicySpecCedar
// Policy expressed in the Cedar policy language. Policies that declare `?principal` and `?resource` slots are templates instantiated via `PolicyBinding`, otherwise they take effect on their own. Only supported by nodes that use Cedar.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/PolicySpec#/$defs/Cedar
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table PolicySpecCedar {
  // Cedar policy source.
  body: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// PolicySpecRoot
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/PolicySpecRoot
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table PolicySpecRoot {
  value: PolicySpec;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ProjectionSpecInput
// Represents a projection of a dataaset history into a state for fast lookups.
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/ProjectionSpecInput
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table ProjectionSpecInput {
  // Datasets that will be used as sources.
  inputs: [TransformInput];
  // Transformation that will be applied to produce new data.
  project: Transform;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ProjectionSpec
// Represents a projection of a dataaset history into a state for fast lookups.
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/ProjectionSpec
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table ProjectionSpec {
  // Datasets that will be used as sources.
  inputs: [TransformInput];
  // Transformation that will be applied to produce new data.
  project: Transform;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// RawQueryRequest
// Sent by the coordinator to an engine to perform query on raw input data, usually as part of ingest preprocessing step
//
// Schema: https://opendatafabric.org/schemas/engines/v1alpha1/RawQueryRequest
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table RawQueryRequest {
  // Paths to input data files to perform query over. Must all have identical schema.
  input_data_paths: [string];
  // Transformation that will be applied to produce new data.
  transform: Transform;
  // Path where query result will be written.
  output_data_path: string;
  // Requires the engine to keep the order of records read from the input in the query result, or fail the request if it cannot.
  //
  // Defaults to: false
  preserve_order: bool = null;
}

union RawQueryResponse {
  RawQueryResponseProgress,
  RawQueryResponseSuccess,
  RawQueryResponseInvalidQuery,
  RawQueryResponseInternalError,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// RawQueryResponseProgress
// Reports query progress
//
// Schema: https://opendatafabric.org/schemas/engines/v1alpha1/RawQueryResponse#/$defs/Progress
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table RawQueryResponseProgress {
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// RawQueryResponseSuccess
// Query executed successfully
//
// Schema: https://opendatafabric.org/schemas/engines/v1alpha1/RawQueryResponse#/$defs/Success
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table RawQueryResponseSuccess {
  // Number of records produced by the query
  num_records: uint64;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// RawQueryResponseInvalidQuery
// Query did not pass validation
//
// Schema: https://opendatafabric.org/schemas/engines/v1alpha1/RawQueryResponse#/$defs/InvalidQuery
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table RawQueryResponseInvalidQuery {
  // Explanation of an error
  message: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// RawQueryResponseInternalError
// Internal error during query execution
//
// Schema: https://opendatafabric.org/schemas/engines/v1alpha1/RawQueryResponse#/$defs/InternalError
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table RawQueryResponseInternalError {
  // Brief description of an error
  message: string;
  // Details of an error (e.g. a backtrace)
  backtrace: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// RawQueryResponseRoot
//
// Schema: https://opendatafabric.org/schemas/engines/v1alpha1/RawQueryResponseRoot
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table RawQueryResponseRoot {
  value: RawQueryResponse;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ReconciliationError
// Condition describing why the controller failed to reconcile the latest generation of a resource. Set by the controller; never written by users.
//
// Schema: https://opendatafabric.org/schemas/resources/v1alpha1/ReconciliationError
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table ReconciliationError {
  // Machine-readable code identifying the type of the error.
  //
  // Examples:
  // - "unresolved-reference"
  code: string;
  // Human-readable description of the error.
  message: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ResourceHeaders
// Container for identity and ownership information of a resource.
//
// Schema: https://opendatafabric.org/schemas/resources/v1alpha1/ResourceHeaders
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table ResourceHeaders {
  // Unique identifier of a resource within entire ODF node. Automatically assigned upon resource creation.
  id: [ubyte];
  // Symbolic name of a resource that identifies it within a scope of an onwing account.
  name: string;
  // Link to the account that owns the resource.
  account: ResourceOwnerHandle;
  // Map of string keys and values that can be used to organize, categorize, and query resources.
  labels: ResourceLabels;
  // Annotations is a key value map stored with a resource that may be set by external tools to store and retrieve arbitrary metadata. Unlike labels, annotations are not indexed and cannot be queried by.
  annotations: ResourceAnnotations;
  // References to resources that created this resource. Used for lineage tracking and cascading cleanup.
  owner_references: [ResourceHandle];
  // A sequential number that changes every time the resource header and spec are updated. Does not increment on status changes, thus signifying changes to the desired state. Populated by the system. Starts with `1`.
  generation: uint64;
  // A sequential number that changes every time the resource status is updated. Can be passed back as a precondition of a status update to make sure the status was not modified since it was read. Populated by the system. Starts with `1`.
  status_generation: uint64;
  // Time when the resource was first applied and assigned an identity.
  created_at: Timestamp;
  // Time when the resource was last updated, including header, spec, and status updates.
  updated_at: Timestamp;
  // Time when deletion of the resource was requested. The resource remains visible until its controllers finish cleaning up and the deletion completes.
  deletion_requested_at: Timestamp;
  // Time when the resource was deleted.
  deleted_at: Timestamp;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ResourcePhase
// Represents the reconciliation or deletion phase of a resource.
//
// Schema: https://opendatafabric.org/schemas/resources/v1alpha1/ResourcePhase
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

enum ResourcePhase: int32 {
  Pending,
  Reconciling,
  Ready,
  Degraded,
  Failed,
  Deleting,
  Deleted,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ResourceConditions
// Container of generic contditions that can be added by contollers to provide additional information about the state of a resource. Keys uniquely identify the condition and should be in the form of a schema URL describing this condition, e.g. `https://opendatafabric.org/schemas/tasks/v1/TaskStatus`.
//
// Schema: https://opendatafabric.org/schemas/resources/v1alpha1/ResourceConditions
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table ResourceConditionsEntry {
  key: string (key);
  // JSON encoded
  value: string (json);
}
table ResourceConditions {
  // Key-value map
  entries: [ResourceConditionsEntry];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ResourceStatus
// Resource lifecycle and reconciliation information.
//
// Schema: https://opendatafabric.org/schemas/resources/v1alpha1/ResourceStatus
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table ResourceStatus {
  // Represents the reconciliation phase of a resource as seen by the main resource controller.
  phase: ResourcePhase;
  // Resource generation that was last seen by the main resource controller.
  observed_generation: uint64 = null;
  // Time when the controller seen the resource state as defined in `observedGeneration`.
  observed_at: Timestamp;
  // Resource generation that was last successfully reconciled by the main resource controller.
  reconciled_generation: uint64 = null;
  // Time when the controller last reconciled the desired resource state as defined in `reconciledGeneration`.
  reconciled_at: Timestamp;
  // Detailed conditions describing the state of the resource that are added by controllers.
  conditions: ResourceConditions;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Resource
// Top-level container for canonical representation of a resource that specifies the type and version of the resource, carries identity, ownership, and status information.
//
// Schema: https://opendatafabric.org/schemas/resources/v1alpha1/Resource
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table Resource {
  // Identifies the controlling entity, a bounded context that this resource belongs to, and the version. Url should follow the pattern `{base-url}/{context}/{version}/{name}` e.g. `https://opendatafabric.org/schemas/datasets/v1/Dataset`.
  schema: string;
  // Container for identity and ownership information of a resource.
  headers: ResourceHeaders;
  // Specifies the desired state of a resource.
  spec: [ubyte];
  // Resource lifecycle and reconciliation information.
  status: ResourceStatus;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ResourceInput
// Top-level container for user-authored representation of a resource that specifies the type and version of the resource and its desired state.
//
// Schema: https://opendatafabric.org/schemas/resources/v1alpha1/ResourceInput
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table ResourceInput {
  // Identifies the controlling entity, a bounded context that this resource belongs to, and the version. Url should follow the pattern `{base-url}/{context}/{version}/{name}` e.g. `https://opendatafabric.org/schemas/datasets/v1/Dataset`.
  schema: string;
  // Container for identity and ownership information of a resource.
  headers: ResourceHeadersInput;
  // Specifies the desired state of a resource.
  spec: [ubyte];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Secret
// Individual secret in raw or encrypted form.
//
// Schema: https://opendatafabric.org/schemas/config/v1alpha1/Secret
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table Secret {
  // A secret value in raw or encoded form.
  value: string;
  // Represents the encoding of the value. Typically will be `jwe` after a raw secret gets encrypted.
  content_encoding: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Secrets
// Container for key-value secrets. Every key must be a string. Values may be strings with raw unencrypted data or objects that signify the encoding.
//
// Schema: https://opendatafabric.org/schemas/config/v1alpha1/Secrets
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SecretsEntry {
  key: string (key);
  value: Secret;
}
table Secrets {
  // Key-value map
  entries: [SecretsEntry];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SecretSetSpecInput
// Defines a set of secrets stored and managed by the ODF node and accessible via embedded sercets provider.
//
// Schema: https://opendatafabric.org/schemas/config/v1alpha1/SecretSetSpecInput
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SecretSetSpecInput {
  // Key value pairs of secrets.
  secrets: Secrets;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SecretSetSpec
// Defines a set of secrets stored and managed by the ODF node and accessible via embedded sercets provider.
//
// Schema: https://opendatafabric.org/schemas/config/v1alpha1/SecretSetSpec
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SecretSetSpec {
  // Key value pairs of secrets.
  secrets: Secrets;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ServiceAccountSpecInput
// Service account specification.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/ServiceAccountSpecInput
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table ServiceAccountSpecInput {
  // Human-friendly display name.
  display_name: string;
  // Suspends the account. Effects of suspension are implementation-specific.
  //
  // Defaults to: false
  disabled: bool = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ServiceAccountSpec
// Service account specification.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/ServiceAccountSpec
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table ServiceAccountSpec {
  // Human-friendly display name.
  display_name: string;
  // Suspends the account. Effects of suspension are implementation-specific.
  //
  // Defaults to: false
  disabled: bool = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ValueRefs
// Container for key-value variables. Every key must be a string. Values shoud reference fields in `SecretSet`s and `VariableSet`s.
//
// Schema: https://opendatafabric.org/schemas/config/v1alpha1/ValueRefs
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table ValueRefsEntry {
  key: string (key);
  value: ValueRef;
}
table ValueRefs {
  // Key-value map
  entries: [ValueRefsEntry];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SourceSpecInput
// Specifies an external source of data for ingestion.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/SourceSpecInput
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SourceSpecInput {
  // Brings the configuration values into the local `config` context.
  config: ValueRefs;
  // Determines where data is sourced from.
  ingress: Ingress;
  // Defines how raw data is prepared before reading.
  prepare: [PrepStepWrapper];
  // Defines how data is read into structured format.
  read: ReadStep;
  // Pre-processing query that shapes the data.
  preprocess: Transform;
  // Determines how newly-ingested data should be merged with existing history.
  merge: MergeStrategy;
  // Defines the mapping of system fields to dataset column names.
  vocab: DatasetVocabulary;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// SourceSpec
// Specifies an external source of data for ingestion.
//
// Schema: https://opendatafabric.org/schemas/sources/v1alpha1/SourceSpec
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table SourceSpec {
  // Brings the configuration values into the local `config` context.
  config: ValueRefs;
  // Determines where data is sourced from.
  ingress: Ingress;
  // Defines how raw data is prepared before reading.
  prepare: [PrepStepWrapper];
  // Defines how data is read into structured format.
  read: ReadStep;
  // Pre-processing query that shapes the data.
  preprocess: Transform;
  // Determines how newly-ingested data should be merged with existing history.
  merge: MergeStrategy;
  // Defines the mapping of system fields to dataset column names.
  vocab: DatasetVocabulary;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TaskPlan
// A self-contained logical execution plan of a task.
//
// Schema: https://opendatafabric.org/schemas/tasks/v1alpha1/TaskPlan
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TaskPlanEntry {
  key: string (key);
  // JSON encoded
  value: string (json);
}
table TaskPlan {
  // Key-value map
  entries: [TaskPlanEntry];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Watermark
// Represents a watermark in the event stream.
//
// Schema: https://opendatafabric.org/schemas/datasets/v1alpha1/Watermark
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table Watermark {
  // Moment in processing time when watermark was emitted.
  system_time: Timestamp;
  // Moment in event time which watermark has reached.
  event_time: Timestamp;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TransformRequestInput
// Sent as part of the engine transform request operation to describe the input
//
// Schema: https://opendatafabric.org/schemas/engines/v1alpha1/TransformRequestInput
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TransformRequestInput {
  // Unique identifier of the dataset.
  dataset_id: [ubyte];
  // Alias of the output dataset, for logging purposes only.
  dataset_alias: string;
  // An alias of this input to be used in queries.
  query_alias: string;
  // Vocabulary of the input dataset.
  vocab: DatasetVocabulary;
  // Subset of data that goes into this transaction.
  offset_interval: OffsetInterval;
  // TODO: This will be removed when coordinator will be slicing data for the engine.
  data_paths: [string];
  // TODO: replace with actual DDL or Parquet schema.
  schema_file: string;
  // Watermarks that should be injected into the stream to separate micro batches for reproducibility.
  explicit_watermarks: [Watermark];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TransformRequest
// Sent by the coordinator to an engine to perform the next step of data transformation
//
// Schema: https://opendatafabric.org/schemas/engines/v1alpha1/TransformRequest
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TransformRequest {
  // Unique identifier of the output dataset.
  dataset_id: [ubyte];
  // Alias of the output dataset, for logging purposes only.
  dataset_alias: string;
  // System time to use for new records.
  system_time: Timestamp;
  // Vocabulary of the output dataset.
  vocab: DatasetVocabulary;
  // Transformation that will be applied to produce new data.
  transform: Transform;
  // Defines inputs used in this transaction. Slices corresponding to every input dataset must be present.
  query_inputs: [TransformRequestInput];
  // Starting offset to use for new data records.
  next_offset: uint64;
  // TODO: This will be removed when coordinator will be speaking to engines purely through Arrow.
  prev_checkpoint_path: string;
  // TODO: This will be removed when coordinator will be speaking to engines purely through Arrow.
  new_checkpoint_path: string;
  // TODO: This will be removed when coordinator will be speaking to engines purely through Arrow.
  new_data_path: string;
}

union TransformResponse {
  TransformResponseProgress,
  TransformResponseSuccess,
  TransformResponseInvalidQuery,
  TransformResponseInternalError,
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TransformResponseProgress
// Reports query progress
//
// Schema: https://opendatafabric.org/schemas/engines/v1alpha1/TransformResponse#/$defs/Progress
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TransformResponseProgress {
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TransformResponseSuccess
// Query executed successfully
//
// Schema: https://opendatafabric.org/schemas/engines/v1alpha1/TransformResponse#/$defs/Success
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TransformResponseSuccess {
  // Data slice produced by the transaction, if any.
  new_offset_interval: OffsetInterval;
  // Watermark advanced by the transaction, if any.
  new_watermark: Timestamp;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TransformResponseInvalidQuery
// Query did not pass validation
//
// Schema: https://opendatafabric.org/schemas/engines/v1alpha1/TransformResponse#/$defs/InvalidQuery
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TransformResponseInvalidQuery {
  // Explanation of an error
  message: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TransformResponseInternalError
// Internal error during query execution
//
// Schema: https://opendatafabric.org/schemas/engines/v1alpha1/TransformResponse#/$defs/InternalError
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TransformResponseInternalError {
  // Brief description of an error
  message: string;
  // Details of an error (e.g. a backtrace)
  backtrace: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// TransformResponseRoot
//
// Schema: https://opendatafabric.org/schemas/engines/v1alpha1/TransformResponseRoot
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table TransformResponseRoot {
  value: TransformResponse;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// UserSpecInput
// User account specification.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/UserSpecInput
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table UserSpecInput {
  // DID associated with the account by ODF or an external system.
  did: [ubyte];
  // Human-friendly display name.
  display_name: string;
  // Email address of the user.
  email: string;
  // URL of the account's avatar image.
  avatar_url: string;
  // Password for local authentication, stored as a hash upon apply. Absent for SSO or DID-based accounts.
  password: Secret;
  // Suspends the account. Effects of suspension are implementation-specific.
  //
  // Defaults to: false
  disabled: bool = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// UserSpec
// User account specification.
//
// Schema: https://opendatafabric.org/schemas/auth/v1alpha1/UserSpec
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table UserSpec {
  // DID associated with the account by ODF or an external system.
  did: [ubyte];
  // Human-friendly display name.
  display_name: string;
  // Email address of the user.
  email: string;
  // URL of the account's avatar image.
  avatar_url: string;
  // Password for local authentication, stored as a hash upon apply. Absent for SSO or DID-based accounts.
  password: Secret;
  // Suspends the account. Effects of suspension are implementation-specific.
  //
  // Defaults to: false
  disabled: bool = null;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Variable
// Individual variable.
//
// Schema: https://opendatafabric.org/schemas/config/v1alpha1/Variable
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table Variable {
  // A value in raw or encoded form.
  value: string;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Variables
// Container for key-value variables. Every key must be a string. Values may be raw strings or objects that incorporate the encoding.
//
// Schema: https://opendatafabric.org/schemas/config/v1alpha1/Variables
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table VariablesEntry {
  key: string (key);
  value: Variable;
}
table Variables {
  // Key-value map
  entries: [VariablesEntry];
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// VariableSetSpecInput
// Defines a set of variables stored and managed by the ODF node and accessible via embedded variables provider.
//
// Schema: https://opendatafabric.org/schemas/config/v1alpha1/VariableSetSpecInput
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table VariableSetSpecInput {
  // Key value pairs of variables.
  variables: Variables;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// VariableSetSpec
// Defines a set of variables stored and managed by the ODF node and accessible via embedded variables provider.
//
// Schema: https://opendatafabric.org/schemas/config/v1alpha1/VariableSetSpec
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table VariableSetSpec {
  // Key value pairs of variables.
  variables: Variables;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// WebhookEndpointSpecInput
// Defines a webhook endpoint that can receive event notifications and data.
//
// Schema: https://opendatafabric.org/schemas/sinks/v1alpha1/WebhookEndpointSpecInput
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table WebhookEndpointSpecInput {
  // URL of the webhook endpoint.
  url: string;
  // Shared secret used for HMAC signature of the request payload for authentication.
  secret: Secret;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// WebhookEndpointSpec
// Defines a webhook endpoint that can receive event notifications and data.
//
// Schema: https://opendatafabric.org/schemas/sinks/v1alpha1/WebhookEndpointSpec
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

table WebhookEndpointSpec {
  // URL of the webhook endpoint.
  url: string;
  // Shared secret used for HMAC signature of the request payload for authentication.
  secret: Secret;
}

