{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                    event_id,\n                    resource_id as id,\n                    resource_schema as \"schema!\",\n                    event_time,\n                    event_type,\n                    event_payload as \"payload!\"\n                FROM resource_events\n                WHERE resource_id = $1\n                  AND resource_schema = $2\n                  AND ($3::bigint IS NULL OR event_id > $3)\n                  AND ($4::bigint IS NULL OR event_id <= $4)\n                ORDER BY event_id\n                ",
