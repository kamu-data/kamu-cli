  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                resource_id AS \"id: uuid::Uuid\",\n                resource_schema,\n                purge_at AS \"purge_at!: DateTime<Utc>\"\n            FROM resources\n            WHERE purge_at IS NOT NULL AND purge_at <= $1\n            ORDER BY purge_at ASC, resource_id ASC\n            LIMIT $2\n            ",
