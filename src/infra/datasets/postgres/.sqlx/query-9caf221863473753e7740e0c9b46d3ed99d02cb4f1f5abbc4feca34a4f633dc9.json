  "query": "\n            SELECT dataset_id   as \"id: _\",\n                   resource_id  as \"resource_id: _\",\n                   owner_id     as \"owner_id: _\",\n                   owner_name,\n                   dataset_name as name,\n                   created_at   as \"created_at: _\",\n                   kind         as \"kind: _\"\n            FROM dataset_entries\n            WHERE owner_id = $1\n              AND lower(dataset_name) = lower($2)\n            ",
