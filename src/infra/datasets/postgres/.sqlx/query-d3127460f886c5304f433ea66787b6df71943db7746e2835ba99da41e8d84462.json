  "db_name": "PostgreSQL",
  "query": "\n            SELECT dataset_id   AS \"id: _\",\n                   resource_id  as \"resource_id: _\",\n                   owner_id     AS \"owner_id: _\",\n                   owner_name,\n                   dataset_name AS name,\n                   created_at   AS \"created_at: _\",\n                   kind         AS \"kind: _\"\n            FROM dataset_entries\n            WHERE (owner_id, lower(dataset_name)) IN (SELECT input_owner_id,\n                                                             lower(input_dataset_name)\n                                                      FROM unnest($1::TEXT[],\n                                                                  $2::TEXT[]) as t(input_owner_id, input_dataset_name))\n            ORDER BY owner_name, dataset_name\n            ",
