{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                    id,\n                    account_id,\n                    quota_type,\n                    event_type,\n                    event_payload as \"event_payload: Value\",\n                    event_time as \"event_time: DateTime<Utc>\"\n                FROM account_quota_events\n                WHERE account_id = $1\n                  AND quota_type = $2\n                  AND ($3::bigint IS NULL OR id > $3)\n                  AND ($4::bigint IS NULL OR id <= $4)\n                ORDER BY id\n                ",
